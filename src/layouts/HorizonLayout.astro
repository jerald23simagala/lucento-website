---
/**
 * Horizon pages (Phase 4). The whole visual system is inlined: tokens, the variable font faces (hashed URLs) and
 * horizon.css, so the first paint needs no stylesheet request and nothing flashes unstyled. The latin font file is
 * preloaded; text paints at once in a metric-matched fallback until it arrives.
 */
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import jakartaLatinExt from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-ext-wght-normal.woff2?url';
import tokensCss from '../styles/horizon-tokens.css?raw';
import horizonCss from '../styles/horizon.css?raw';
import HzHeader from '../components/horizon/HzHeader.astro';
import HzFooter from '../components/horizon/HzFooter.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
// latin-ext holds ₱ (U+20B1); the browser fetches it only when a page shows one of these characters.
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const face = (url: string, range: string) =>
  `@font-face{font-family:"Plus Jakarta Sans";font-style:normal;font-display:swap;font-weight:200 800;src:url("${url}") format("woff2-variations"),url("${url}") format("woff2");unicode-range:${range}}`;

// Light minification: comments out, whitespace collapsed (no strings in these files depend on runs of spaces).
const minify = (css: string) =>
  css
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/\s+/g, ' ')
    .replace(/\s*([{};,>])\s*/g, '$1')
    .trim();
const inlineCss = face(jakartaLatin, LATIN) + face(jakartaLatinExt, LATIN_EXT) + minify(tokensCss) + minify(horizonCss);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFFDF5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1229" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="preload" href={jakartaLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:inline set:html={inlineCss}></style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <HzHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <HzFooter />
  </body>
</html>
