---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import { guides } from '../data/guides';
---

<BaseLayout
  title="How to use Lucento — interactive guides"
  description="Interactive, step-by-step guides for Lucento: try each task on a simulated phone — setting up, adding transactions, budgets, wallets, bills, debts, goals, a new phone, sync, Smarter reading and export."
>
  <PhoneDemo
    id="guide"
    eyebrow="How to"
    heading="Learn Lucento by using it"
    intro="Pick a guide and do it yourself on the phone: each step completes when you do it. Fictional money; nothing is saved or sent. Prefer reading? Every guide is written out below."
    stories={guides.map((g) => g.id)}
    picker="list"
  />

  <section class="written" aria-labelledby="written-title">
    <p class="kicker">The same steps, written out</p>
    <h2 id="written-title">Read a guide, then try it</h2>
    <div class="guides">
      {
        guides.map((g, index) => (
          <article class="guide" id={g.id} aria-labelledby={`${g.id}-title`}>
            <p class="num">{String(index + 1).padStart(2, '0')}</p>
            <div>
              <h3 id={`${g.id}-title`}>{g.title}</h3>
              <p class="summary">{g.summary}</p>
              <ol class="steps">
                {g.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
              {g.tip && <p class="tip">{g.tip}</p>}
              <a class="text-link" href={`#guide-${g.id}`}>
                Try it on the phone
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .written {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 var(--page-gutter) var(--page-pad);
  }

  h2 {
    margin: 0.4rem 0 0;
    max-width: 14ch;
    font-size: clamp(2rem, 2.4vw + 1rem, 3rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .guides {
    margin-top: 1.5rem;
  }

  .guide {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--outline-variant);
    scroll-margin-top: 5.5rem;
  }

  .num {
    margin: 0.15rem 0 0;
    color: var(--primary);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .summary {
    margin: 0.35rem 0 0;
    color: var(--on-surface-variant);
  }

  .steps {
    margin: 1rem 0 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.55rem;
  }

  .steps li::marker {
    font-weight: 700;
    color: var(--primary);
  }

  .tip {
    margin: 1rem 0 0;
    padding: 0.85rem 0 0.85rem 0.9rem;
    border-left: 3px solid var(--mark-gold);
    background: var(--highlight);
    color: var(--on-highlight);
  }

  @media (max-width: 520px) {
    .guide {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
