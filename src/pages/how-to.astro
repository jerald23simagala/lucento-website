---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import { guides } from '../data/guides';
---

<BaseLayout
  title="How to use Lucento — interactive guides"
  description="Interactive, step-by-step guides for Lucento: try each task on a simulated phone — setting up, adding transactions, budgets, wallets, bills, debts, goals, a new phone, sync, Smarter reading and export."
>
  <PhoneDemo
    id="guide"
    hashPrefix="guide-"
    level={1}
    eyebrow="Guides"
    heading="Use it on the phone. The steps are here too."
    intro="Every guide is the same simulation as the home page, with the written steps underneath. Fictional money. Nothing is saved or sent."
    stories={guides.map((guide) => guide.id)}
    initial="budget"
  />
</BaseLayout>
