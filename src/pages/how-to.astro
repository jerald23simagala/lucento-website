---
// Old guide URLs land here. A script keeps the hash (`#guide-budget`, `#add-transactions`)
// because a meta refresh would drop it. The link is the no-JavaScript path.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Guides · Lucento</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      location.replace('/demo' + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content="0;url=/demo" />
  </head>
  <body>
    <p><a href="/demo">Continue to the guides</a></p>
  </body>
</html>
