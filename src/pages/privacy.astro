---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import LegalBody from '../components/LegalBody.astro';
import { privacy, UPDATED, VERSION } from '../data/legal';
import { mailto, site } from '../data/site';

// The app's Privacy Policy covers the app. This website adds only what the site itself does.
const website = {
  title: 'This website',
  items: [
    'The site is hosted on Vercel and uses no advertising or tracking cookies.',
    'Lucento’s server runs on this site’s domain for the app’s online features (the AI features you turn on and Google Play purchase checks). It keeps no copy of the messages it is sent.',
  ],
};
---

<SiteLayout appTokens
  title="Privacy Policy — Lucento"
  description="What stays on your phone, what leaves it and when: accounts, cloud sync, Lucento Shared, purchases, exchange rates, the AI features, and how to delete your account."
>
  <ContentPage eyebrow="Privacy" title={privacy.title} lede={privacy.intro}>
    <p class="content-meta" slot="meta">
      Updated {UPDATED} (version {VERSION}). The app shows the same policy in Settings › Privacy &amp; security.
      Questions or data requests: <a href={mailto('Privacy question')}>{site.contactEmail}</a>. To delete your account,
      see <a href="/delete-account">Delete your account</a>.
    </p>
    <LegalBody sections={[...privacy.sections, website]} />
  </ContentPage>
</SiteLayout>
