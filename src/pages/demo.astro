---
import SiteLayout from '../layouts/SiteLayout.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import { guides } from '../data/guides';
import { STORIES } from '../demo/simulator';

// Newer guides are written out only; the phone demo offers the ones it can play.
const playable = guides.filter((g) => g.id in STORIES);
---

<SiteLayout
  appTokens
  title="Interactive demo: try Lucento in your browser"
  description="Interactive, step-by-step guides for Lucento: try each task on a simulated phone — setting up, adding transactions, budgets, wallets, bills, debts, goals, a new phone, sync, Smarter reading, sharing, other currencies, deleting your account and export."
>
  <link slot="head" rel="stylesheet" href="/demo/app-fonts.css" />
  <link slot="head" rel="preload" as="image" href="/demo/art/illustration_sunrise_landscape.webp" fetchpriority="high" />
  <link slot="head" rel="preload" as="font" type="font/woff2" href="/demo/fonts/plus_jakarta_sans_semibold.woff2" crossorigin />
  <PhoneDemo
    id="guide"
    eyebrow="Interactive demo"
    heading="Learn Lucento by using it"
    intro="Pick a guide and do it yourself on the phone: each step completes when you do it. Fictional money; nothing is saved or sent. Prefer reading? Every guide is written out below."
    stories={playable.map((g) => g.id)}
    picker="list"
    level={1}
  />

  <section class="written" aria-labelledby="written-title">
    <p class="eyebrow">Prefer to read?</p>
    <h2 id="written-title">The same guides, step by step</h2>
    <div class="guides">
      {
        guides.map((g) => (
          <section class="guide" id={g.id} aria-labelledby={`${g.id}-title`}>
            <h3 id={`${g.id}-title`}>{g.title}</h3>
            <p class="summary">{g.summary}</p>
            <ol class="steps">
              {g.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            {g.tip && <p class="tip">{g.tip}</p>}
            {g.id in STORIES ? (
              <a class="try" href={`#guide-${g.id}`}>
                Try it on the phone
              </a>
            ) : (
              <p class="written-only">Written guide only</p>
            )}
          </section>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .written {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-xxl) var(--page-gutter);
  }

  .eyebrow {
    margin: 0;
    color: var(--primary);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: var(--space-xs) 0 0;
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .guides {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .guide {
    padding: var(--space-xl);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-container-lowest);
    scroll-margin-top: var(--space-lg);
  }

  .num {
    margin: 0;
    font-weight: 800;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: var(--space-xxs) 0 0;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .summary {
    margin: var(--space-xs) 0 0;
    color: var(--on-surface-variant);
  }

  .steps {
    margin: var(--space-lg) 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-sm);
  }

  .steps li::marker {
    font-weight: 700;
    color: var(--primary);
  }

  .written-only {
    margin: var(--space-lg) 0 0;
    color: var(--on-surface-variant);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tip {
    margin: var(--space-lg) 0 0;
    padding: var(--space-md);
    border-radius: var(--radius-md);
    background: var(--highlight);
    color: var(--on-highlight);
  }

  .try {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch);
    margin-top: var(--space-lg);
    padding: 0 var(--space-lg);
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
    text-decoration: none;
  }
</style>
