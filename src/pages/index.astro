---
import BaseLayout from '../layouts/BaseLayout.astro';
import Explainer from '../components/Explainer.astro';
import Mascot from '../components/Mascot.astro';
import PaceCalculator from '../components/PaceCalculator.astro';
import { guides } from '../data/guides';
import { faq, limitations, realLife } from '../data/site';

const guideIds = guides.map((guide) => guide.id);
---

<BaseLayout
  title="Lucento — a budget tracker for Android"
  description="Lucento is an Android budget tracker in development. It sets what you’ve spent beside the month, turns a sentence into transactions, and keeps the record on your phone."
>
  <script slot="head" is:inline define:vars={{ guideIds }}>
    (function () {
      const hash = location.hash.slice(1);
      if (!hash) return;
      const toDemo = hash === 'try' || hash === 'guides' || hash.indexOf('guide-') === 0 || guideIds.indexOf(hash) !== -1;
      if (toDemo) location.replace('/demo' + (hash === 'try' ? '' : location.hash));
    })();
  </script>

  <header class="hero">
    <div class="hero-id">
      <Mascot
        pose="greeting"
        size="4.5rem"
        eager
        alt="Lucento mascot concept: a golden orb with a hair crest and a bright crystal torch."
      />
      <p class="kicker ruled">Android · in development</p>
    </div>
    <h1>The month, beside what you’ve spent.</h1>
    <p class="lede">A budget tracker that keeps the record on your phone.</p>
    <a class="btn" href="/demo">Try the demo</a>
    <Explainer />
  </header>

  <section class="block" aria-labelledby="pace-figure-title">
    <h2 id="pace-figure-title">Budget beside the month</h2>
    <figure class="pace">
      <div class="pace-row">
        <div class="pace-meta">
          <span>Budget used</span>
          <b class="num">63%</b>
        </div>
        <div class="track" aria-hidden="true">
          <span class="fill used" style="width: 63%"></span>
        </div>
      </div>
      <div class="pace-row">
        <div class="pace-meta">
          <span>Month passed</span>
          <b class="num">64%</b>
        </div>
        <div class="track" aria-hidden="true">
          <span class="fill month" style="width: 64%"></span>
        </div>
      </div>
      <p class="verdict">In step <span class="sun" aria-hidden="true"></span></p>
      <p class="allow">About <b class="num">$50.00</b> a day for the next 12 days</p>
      <figcaption>
        Example only: day 20 of 31, budget $1,600, spent $1,000. Not your records. Close bars mean the spending is
        keeping up with the calendar. The app never converts currencies.
      </figcaption>
    </figure>
  </section>

  <section class="block" aria-labelledby="sentence-title">
    <h2 id="sentence-title">A sentence becomes rows</h2>
    <figure class="sentence">
      <p class="said">Lunch 45, groceries 120, parking 15</p>
      <ol>
        <li>
          <span>Lunch</span>
          <b class="num">45.00</b>
        </li>
        <li>
          <span>Groceries</span>
          <b class="num">120.00</b>
        </li>
        <li>
          <span>Parking</span>
          <b class="num">15.00</b>
        </li>
      </ol>
      <figcaption>
        Nothing is written until you tap Save. A receipt or spoken English is read on the phone. A row with no amount
        can’t be saved — Lucento does not guess a number.
      </figcaption>
    </figure>
  </section>

  <section class="block" id="keeps" aria-labelledby="keeps-title">
    <h2 id="keeps-title">The record stays on the phone</h2>
    <figure class="where">
      <div class="where-main">
        <p>On this phone</p>
        <ul>
          <li>Stored on the device</li>
          <li>Core features work offline</li>
          <li>No bank login</li>
          <li>No ads, analytics, or crash reporting</li>
        </ul>
      </div>
      <div class="where-opt">
        <p>Optional</p>
        <ul>
          <li>Google or email sync, for a backup and a new phone</li>
          <li>Signing out leaves the phone’s copy in place</li>
          <li>Smarter reading stays off until you turn it on</li>
          <li>Then it sends the message, date, currency, and names — never balances or history</li>
        </ul>
      </div>
      <figcaption>
        Sync uses your own signed-in account. Receipts are always read on the phone. Pricing has not been announced,
        and Lucento is not on Google Play yet.
      </figcaption>
    </figure>
  </section>

  <section class="block" aria-labelledby="also-title">
    <h2 id="also-title">The rest of the month</h2>
    <div class="facts">
      <article>
        <h3>Wallets</h3>
        <p class="eq"><span>Assets</span> − <span>debts</span> = <b>net worth</b></p>
        <p>Cash, bank, e-wallets, savings, cards, and loans. A transfer is never income or spending. Currencies stay separate.</p>
      </article>
      <article>
        <h3>Bills and income</h3>
        <p class="eq">Due <b>→</b> you mark it paid</p>
        <p>Rent, subscriptions, and salary. The bell shows what’s overdue or due within 7 days. Nothing is recorded until you confirm.</p>
      </article>
      <article>
        <h3>Cards and loans</h3>
        <p class="eq">Payment − <b>interest you enter</b> = principal</p>
        <p>You type the interest from the statement. That part is spending. The rest lowers what you owe.</p>
      </article>
      <article>
        <h3>Goals</h3>
        <p class="eq">Progress <b>without</b> a second balance</p>
        <p>A target, an optional date, and a picture. The money stays in your wallets, so it isn’t counted twice.</p>
      </article>
    </div>
    <p class="aside">Insights show income, spending, and what net worth is made of, with the figures beside every chart.</p>
  </section>

  <PaceCalculator />

  <section class="block" id="careful" aria-labelledby="careful-title">
    <h2 id="careful-title">It will not guess</h2>
    <dl class="rules">
      {
        realLife.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="block" id="privacy" aria-labelledby="privacy-title">
    <h2 id="privacy-title">What leaves the phone</h2>
    <ul class="leaves">
      <li><b>Nothing</b> until you opt in</li>
      <li><b>Sync</b> only with Google or email, while it stays on</li>
      <li><b>Smarter reading</b> only the message, date, currency, and names</li>
      <li><b>Never</b> your balances or history</li>
    </ul>
    <a class="text-link" href="/privacy">How Lucento handles your data</a>
  </section>

  <div class="split">
    <section class="block" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
    <section class="block" id="good-to-know" aria-labelledby="limits-title">
      <h2 id="limits-title">Current limitations</h2>
      <dl class="rules">
        {
          limitations.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="close" id="get" aria-labelledby="get-title">
    <div class="close-inner">
      <h2 id="get-title">Not on Google Play yet</h2>
      <p>Lucento is in development. Pricing has not been announced.</p>
      <a class="btn" href="/demo">Try the demo</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero,
  .block {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.25rem) var(--page-gutter) 0;
  }

  .hero {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-id {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-id .kicker {
    margin: 0;
  }

  h1 {
    margin: 0.55rem 0 0;
    max-width: 14em;
    font-size: clamp(2.15rem, 4vw + 1rem, 3.6rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.35rem, 1vw + 1rem, 1.85rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0.6rem 0 0;
    color: var(--on-surface-variant);
  }

  .hero .btn,
  .close .btn {
    margin-top: 0.9rem;
  }

  .pace,
  .sentence,
  .where {
    margin: 0.85rem 0 0;
  }

  .pace-row + .pace-row {
    margin-top: 0.75rem;
  }

  .pace-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-weight: 700;
  }

  .pace-meta b {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .track {
    display: block;
    height: 0.85rem;
    margin-top: 0.3rem;
    border-radius: 999px;
    background: var(--track);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: inherit;
  }

  .fill.used {
    background: var(--mark-blue);
  }

  .fill.month {
    background: var(--mark-sky);
  }

  .verdict,
  .allow {
    margin: 0.85rem 0 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .allow {
    font-size: 1.05rem;
    font-weight: 650;
  }

  .sun {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    margin-left: 0.25rem;
    border-radius: 50%;
    background: var(--mark-sun);
    box-shadow: -0.85rem 0 0 var(--mark-gold);
    vertical-align: 0.05rem;
  }

  figcaption,
  .aside {
    max-width: 42rem;
    margin: 0.7rem 0 0;
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .said {
    margin: 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--outline-variant);
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .sentence ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sentence li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--outline-variant);
    font-weight: 700;
  }

  .sentence li b {
    font-variant-numeric: tabular-nums;
  }

  .where {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.85rem 1.25rem;
  }

  .where-main,
  .where-opt {
    padding-top: 0.15rem;
  }

  .where-main {
    border-top: 4px solid var(--mark-blue);
  }

  .where-opt {
    border-top: 4px dashed var(--mark-sky);
  }

  .where p {
    margin: 0.65rem 0 0;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .where ul,
  .leaves {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .where li,
  .leaves li {
    padding: 0.35rem 0;
    border-top: 1px solid var(--outline-variant);
  }

  .where figcaption {
    grid-column: 1 / -1;
  }

  .facts {
    display: grid;
    gap: 0;
    margin-top: 0.4rem;
  }

  .facts article {
    padding: 0.85rem 0;
    border-top: 1px solid var(--outline-variant);
  }

  .eq {
    margin: 0.2rem 0 0;
    font-size: clamp(1.15rem, 1.5vw, 1.45rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .facts article p:last-child {
    margin: 0.25rem 0 0;
    max-width: 40rem;
    color: var(--on-surface-variant);
  }

  .rules {
    margin: 0.35rem 0 0;
  }

  .rules div {
    display: grid;
    grid-template-columns: minmax(9rem, 16rem) minmax(0, 1fr);
    gap: 0.15rem 1.25rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--outline-variant);
  }

  .rules dt {
    margin: 0;
    font-weight: 750;
  }

  .rules dd {
    margin: 0;
    color: var(--on-surface-variant);
  }

  .leaves {
    max-width: 36rem;
    margin-top: 0.6rem;
  }

  .leaves b {
    font-weight: 800;
  }

  .text-link {
    margin-top: 0.55rem;
  }

  .split {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-gutter) clamp(1.25rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 0 2.5rem;
    align-items: start;
  }

  .split .block {
    max-width: none;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
  }

  .faq {
    margin-top: 0.35rem;
    border-top: 1px solid var(--outline-variant);
  }

  details {
    border-bottom: 1px solid var(--outline-variant);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.45rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--border-focus);
    outline-offset: 2px;
  }

  summary::after {
    content: '';
    width: 0.7rem;
    height: 2px;
    margin-left: auto;
    flex: none;
    background: var(--primary);
    box-shadow: 0 -5px 0 var(--primary);
  }

  details[open] summary::after {
    box-shadow: none;
  }

  details p {
    margin: 0 0 0.75rem;
    color: var(--on-surface-variant);
  }

  .close {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    background: var(--highlight);
    color: var(--on-highlight);
  }

  .close-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(1.35rem, 3vw, 2.25rem) var(--page-gutter);
  }

  .close p {
    max-width: 36rem;
    margin: 0.4rem 0 0;
  }

  .close .btn {
    background: var(--on-highlight);
    color: var(--highlight);
  }

  @media (max-width: 800px) {
    .where,
    .split,
    .rules div {
      grid-template-columns: 1fr;
    }
  }
</style>
