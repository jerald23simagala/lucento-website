---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import PaceCalculator from '../components/PaceCalculator.astro';
import { guides } from '../data/guides';
import { faq, limitations, realLife } from '../data/site';

const keeps = [
  {
    title: 'Budget pace',
    body: 'Each category has a monthly amount. The month’s budget is their sum. Home sets how much you’ve used beside how much of the month has passed, and what a day can still be.',
  },
  {
    title: 'A sentence, a receipt, or speech',
    body: '“Lunch 45, groceries 120, parking 15” becomes rows to check and save together. Receipts and speech are read on the phone. English for now. Nothing is written until you tap Save.',
  },
  {
    title: 'Wallets and net worth',
    body: 'Cash, bank, e-wallets, savings, cards and loans. Net worth is assets minus debts. A transfer is never income or spending, and currencies are never converted.',
  },
  {
    title: 'Bills and income',
    body: 'Schedule rent, subscriptions and salary. The bell shows what’s overdue or due within 7 days. Nothing is recorded until you mark it paid or received.',
  },
  {
    title: 'Cards and loans',
    body: 'You enter the interest from your statement. That part counts as spending. The principal lowers what you owe.',
  },
  {
    title: 'Goals',
    body: 'A target, an optional date and picture, and progress. The money stays in your wallets, so it isn’t counted twice.',
  },
  {
    title: 'Insights',
    body: 'Income and spending trends, and what net worth is made of. Every chart has its figures beside it.',
  },
  {
    title: 'Sync, if you want it',
    body: 'The record stays on the phone. A Google or email account is only for backup and a new phone. Signing out does not delete what’s on the device.',
  },
  {
    title: 'Smarter reading',
    body: 'Off unless you turn it on. Then the message, today’s date, your main currency and your category and account names go to Gemini — never balances or history.',
  },
];

const privacy = [
  ['On the phone', 'The record is stored on the device. Every core feature works offline.'],
  ['No bank login', 'You record what you choose to record. There is no access to your accounts.'],
  ['No ads', 'No ads, no analytics and no crash reporting.'],
  ['Sync is optional', 'Nothing leaves the phone until you connect a Google or email account and keep sync on.'],
];
---

<BaseLayout
  title="Lucento — a budget tracker for Android"
  description="Lucento is an Android budget tracker in development. Describe spending in a sentence, compare it with the month, and keep the record on your phone. Try the simulation in your browser."
>
  <PhoneDemo
    id="try"
    hashPrefix="guide-"
    level={1}
    eyebrow="Android budget tracker · in development"
    heading="The month, beside what you’ve spent."
    intro="Describe a purchase, check the rows, and Home compares the budget you’ve used with how far the month has gone. Offline, on your phone, with no bank login."
    stories={guides.map((guide) => guide.id)}
    initial="budget"
  />

  <section class="sheet" id="keeps" aria-labelledby="keeps-title">
    <h2 id="keeps-title">What it keeps</h2>
    <dl class="ledger">
      {
        keeps.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <PaceCalculator />

  <section class="sheet" id="careful" aria-labelledby="careful-title">
    <h2 id="careful-title">It will not guess</h2>
    <dl class="ledger">
      {
        realLife.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.body}</dd>
          </div>
        ))
      }
    </dl>
    <a class="text-link" href="#guide-add-transactions">Try a message on the phone</a>
  </section>

  <section class="sheet" id="privacy" aria-labelledby="privacy-title">
    <h2 id="privacy-title">Your money stays on your phone</h2>
    <dl class="ledger">
      {
        privacy.map(([title, body]) => (
          <div>
            <dt>{title}</dt>
            <dd>{body}</dd>
          </div>
        ))
      }
    </dl>
    <a class="text-link" href="/privacy">How Lucento handles your data</a>
  </section>

  <div class="split">
    <section class="sheet" id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="sheet" id="good-to-know" aria-labelledby="limits-title">
      <h2 id="limits-title">Current limitations</h2>
      <dl class="ledger">
        {
          limitations.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="close" id="get" aria-labelledby="get-title">
    <div class="close-inner">
      <h2 id="get-title">Not on Google Play yet</h2>
      <p>Lucento is in development. Pricing has not been announced. Until release, the phone above is how you see it work.</p>
      <a class="text-link" href="#try">Back to the demo</a>
    </div>
  </section>
</BaseLayout>

<style>
  .sheet {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(1.25rem, 2.5vw, 2rem) var(--page-gutter);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.35rem, 1vw + 1rem, 1.75rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .ledger {
    margin: 0.65rem 0 0;
  }

  .ledger div {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
    gap: 0.15rem 1.25rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-top: 1px solid var(--outline-variant);
  }

  .ledger dt {
    margin: 0;
    font-weight: 750;
  }

  .ledger dd {
    margin: 0;
    color: var(--on-surface-variant);
  }

  .text-link {
    margin-top: 0.35rem;
  }

  .split {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-gutter) clamp(1.25rem, 2.5vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 1.25rem 2.5rem;
    align-items: start;
  }

  .split .sheet {
    max-width: none;
    margin: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem) 0 0;
  }

  .faq {
    margin-top: 0.35rem;
    border-top: 1px solid var(--outline-variant);
  }

  details {
    border-bottom: 1px solid var(--outline-variant);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.45rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--border-focus);
    outline-offset: 2px;
  }

  summary::after {
    content: '';
    width: 0.7rem;
    height: 2px;
    margin-left: auto;
    flex: none;
    background: var(--primary);
    box-shadow: 0 -5px 0 var(--primary);
  }

  details[open] summary::after {
    box-shadow: none;
  }

  details p {
    margin: 0 0 0.75rem;
    color: var(--on-surface-variant);
  }

  .close {
    background: var(--highlight);
    color: var(--on-highlight);
  }

  .close-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(1.25rem, 2.5vw, 2rem) var(--page-gutter);
  }

  .close p {
    max-width: 40rem;
    margin: 0.4rem 0 0;
  }

  .close .text-link {
    color: var(--on-highlight);
  }

  @media (max-width: 800px) {
    .split,
    .ledger div {
      grid-template-columns: 1fr;
    }
  }
</style>
