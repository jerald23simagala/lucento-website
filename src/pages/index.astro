---
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import PhoneShot from '../components/PhoneShot.astro';
import DayMarks from '../components/DayMarks.astro';
import Glyph from '../components/Glyph.astro';
import HeroComposer from '../components/HeroComposer.astro';
import LightStates from '../components/LightStates.astro';
import AppShowcase from '../components/AppShowcase.astro';
import { answers, checkRows, icons, limits } from '../data/home';

const shot = '(min-width: 700px) 340px, 100vw';
---

<BaseLayout
  title="Lucento — a little light for your money"
  description="Type a day’s spending the way you’d text it. Lucento turns the sentence into rows you check before anything is saved. Records work offline, on your phone, with no bank login. Speech only requests on-device recognition, which isn’t guaranteed."
  theme="light"
>
  <section class="lx-wrap lx-hero" id="write" aria-labelledby="h-hero">
    <DayMarks day={5} />
    <div class="lx-kicker-row">
      <p>01 · Write it</p>
      <p class="lx-day">Day 5</p>
    </div>
    <div class="lx-hero-grid">
      <div class="lx-hero-copy">
        <p>Lucento — a budget tracker for Android</p>
        <h1 class="lx-display" id="h-hero">Say what you spent. <span class="lx-soft">Lucento does the sums.</span></h1>
        <p class="lx-lede">
          Type a day’s spending the way you’d text it. Lucento turns the sentence into rows you check before anything
          is saved, then tells you whether the month is on pace. On your phone, with no bank login. What you type
          works offline. Speech only asks the recogniser to stay on the device, and that isn’t guaranteed.
        </p>
        <div class="lx-actions">
          <a class="lx-btn" href="#try">Open the full demo</a>
          <p class="lx-quiet">Or try the phone on this page →</p>
        </div>
      </div>
      <div class="lx-hero-stage">
        <div class="lx-phones">
          <div class="lx-back">
            <PhoneShot
              id="06-home-within-budget"
              source="06-home-within-budget.png"
              alt=""
              sizes="(min-width: 640px) 270px, 1px"
              fallback="Home, with the month on pace."
              eager
            />
          </div>
          <div class="lx-front">
            <HeroComposer />
          </div>
        </div>
        <p class="lx-caption">
          Tap a suggestion inside the phone. A preview with fictional money; behind it, the real Home screen.
        </p>
      </div>
    </div>
    <ul class="lx-promises">
      <li>Works offline for what you type</li>
      <li>No bank login</li>
      <li>Nothing you type leaves your phone unless you sync</li>
      <li>Message, receipt or voice</li>
    </ul>
    <p class="lx-fine">
      Speech recognition only requests offline mode. Your phone’s recogniser may still use the network. Receipts are
      read on the device.
    </p>
  </section>

  <section class="lx-wrap lx-section" id="check" aria-labelledby="h-check">
    <DayMarks day={12} />
    <div class="lx-kicker-row">
      <p>02 · Check it</p>
      <p class="lx-day">Day 12</p>
    </div>
    <div class="lx-split">
      <div class="lx-split-phone">
        <PhoneShot
          id="09-composer-rows"
          source="09-composer-rows.png"
          sizes={shot}
          fallback="One incomplete row, and Save waits until it is fixed."
          alt="Lucento’s Add transactions screen saying 1 transaction is incomplete, with the save button reading Fix 1 highlighted to save."
        />
        <p class="lx-caption">In the app: one incomplete row, and Save waits until it’s fixed.</p>
      </div>
      <div class="lx-split-copy">
        <h2 class="lx-title" id="h-check">An honest ledger, <span class="lx-soft">written for real life.</span></h2>
        <p class="lx-lede">
          Messy messages make messy records. Before you save, Lucento marks anything that looks wrong, and nothing is
          stored until you tap Save.
        </p>
        <div class="lx-ledger">
          {
            checkRows.map((row, index) => (
              <article>
                <div class="lx-row">
                  <span class="lx-tile" style={`background:${row.tile}`}>
                    <Glyph d={icons[row.icon]} stroke={row.glyph} />
                  </span>
                  <span class="lx-row-copy">
                    <span>{row.title}</span>
                    <span class:list={['lx-flag', row.flagTone === 'warn' ? 'is-warn' : 'is-mute']}>{row.flag}</span>
                  </span>
                  <span class:list={['lx-amt', row.dashed && 'is-dashed']} style={row.dashed ? undefined : `color:${row.amountColor}`}>
                    {row.amount}
                  </span>
                </div>
                <p class="lx-explain">
                  <b>{index + 1}</b>
                  {row.text}
                </p>
              </article>
            ))
          }
          <p class="lx-note">Offline? It saves on your phone and syncs later, if you use sync.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lx-pace" id="pace" aria-labelledby="h-pace">
    <div class="lx-wrap lx-section">
      <div class="lx-kicker-row">
        <p>03 · Keep pace</p>
        <p class="lx-day">Day 27</p>
      </div>
      <div class="lx-split">
        <div class="lx-split-copy">
          <h2 class="lx-title" id="h-pace">Is your money moving faster than the month?</h2>
          <div class="lx-stats">
            <div class="lx-stat">
              <strong>89%</strong>
              <p>of the budget spent</p>
              <small>$2,297.99 of $2,590.00</small>
            </div>
            <div class="lx-stat is-soft">
              <strong>87%</strong>
              <p>of the month gone</p>
              <small>Day 27 of 31</small>
            </div>
          </div>
          <p class="lx-pace-line">Spending in step with the month</p>
          <p class="lx-pace-advice">About <span class="lx-amt">$58.40</span> a day keeps you within budget.</p>
        </div>
        <div class="lx-split-phone">
          <PhoneShot
            id="15-budget"
            source="15-budget.png"
            sizes={shot}
            fallback="Budget for October: $292.01 left, and a line that marks today."
            alt="Lucento’s Budget screen for October 2026: $292.01 left of $2,590.00, 89% spent, $58.40 per day, with a line marking that 87% of the month has gone."
          />
          <p class="lx-caption">Budget tab. The line marks today.</p>
        </div>
      </div>
      <div class="lx-month" role="img" aria-label="A month drawn as 31 days. 27 days have passed; 89% of the budget is spent.">
        <div class="lx-month-bar" aria-hidden="true"><span></span></div>
        <DayMarks day={27} variant="month" />
        <div class="lx-month-labels">
          <span>1 Oct</span>
          <span>Today, day 27</span>
          <span>31 Oct</span>
        </div>
      </div>
      <p class="lx-fine">Figures from the app’s demo data. In the app, Home and Budget work this out from your own records.</p>
    </div>
  </section>

  <section class="lx-light lx-section" id="light" aria-labelledby="h-light">
    <div class="lx-wrap">
      <DayMarks day={29} night />
      <div class="lx-kicker-row">
        <p>04 · See the light</p>
        <p class="lx-day">Day 29</p>
      </div>
      <LightStates />
    </div>
  </section>

  <AppShowcase />

  <section class="lx-privacy lx-section" id="privacy" aria-labelledby="h-privacy">
    <div class="lx-wrap lx-privacy-grid">
      <div>
        <p class="lx-eyebrow">Privacy</p>
        <h2 id="h-privacy">Your money stays on your phone.</h2>
      </div>
      <ul class="lx-facts">
        <li><strong>No bank login. No ads.</strong> You record what you choose to record.</li>
        <li><strong>Your data lives on the device.</strong> Sync is optional, and signing out deletes nothing on your phone.</li>
        <li><strong>Receipts are read on your phone.</strong> With an on-device model. Always.</li>
        <li>
          <strong>Read messages with Gemini is optional.</strong> It’s a cloud service under Settings › Smarter
          reading, and it needs a sync account. With it off, messages are read on the phone.
        </li>
        <li><a href="/privacy">How Lucento handles your data</a></li>
      </ul>
    </div>
  </section>

  <section class="lx-wrap lx-section" id="answers" aria-labelledby="h-answers">
    <h2 class="lx-title" id="h-answers">Straight answers.</h2>
    <div class="lx-answers">
      <div class="lx-faq">
        {
          answers.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <div class="lx-limits">
        <p>What it doesn’t do yet</p>
        <ul>
          {limits.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="lx-close" aria-labelledby="h-close">
    <div class="lx-wrap">
      <DayMarks day={31} />
      <div class="lx-kicker-row">
        <p>A month, well kept</p>
        <p class="lx-day">Day 31</p>
      </div>
      <div class="lx-close-grid">
        <div class="lx-close-copy">
          <h2 class="lx-title" id="h-close">Coming to <span class="lx-nowrap">Google Play.</span></h2>
          <p class="lx-lede">
            Lucento is still in development. Until it ships, the whole composer runs in your browser with made-up money
            — no install, nothing to sign up for.
          </p>
          <div class="lx-actions">
            <a class="lx-btn" href="#try">Try Lucento in your browser</a>
            <a class="lx-textlink" href="/how-to">Open the guides</a>
          </div>
        </div>
        <div class="lx-close-phone">
          <PhoneShot
            id="01-onboarding-welcome"
            source="01-onboarding-welcome.png"
            sizes={shot}
            fallback="The welcome screen: Get started, or I already have an account."
            alt="Lucento’s welcome screen: the logo, the line Financial clarity without the complexity, the mascot in a sunrise landscape, Get started and I already have an account."
          />
          <p class="lx-caption">The first screen you’ll see.</p>
        </div>
      </div>
    </div>
  </section>

  <PhoneDemo stories={['add-transactions', 'scheduled', 'budget', 'new-phone']} />
</BaseLayout>
