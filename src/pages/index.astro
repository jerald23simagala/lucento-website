---
/**
 * Lucento's homepage (2026-11-08 reimagination): one page for the whole product. Typography-first and editorial
 * (docs/WEBSITE_DESIGN.md); the app itself is the picture: every screen is a real capture from the API 36 screenshot
 * tour or WebsiteShowcaseTest. Claims are checked against the app (src/data/content.ts names the sources).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import PlayCta from '../components/site/PlayCta.astro';
import Phone from '../components/site/Phone.astro';
import StatusBar from '../components/site/StatusBar.astro';
import HeroStage from '../components/site/HeroStage.astro';
import ThemeStudio from '../components/site/ThemeStudio.astro';
import Pricing from '../components/site/Pricing.astro';
import TypeDemo from '../components/site/TypeDemo.astro';
import FeatureGlyph from '../components/site/FeatureGlyph.astro';
import SharedArt from '../components/site/SharedArt.astro';
import Dialog from '../components/site/Dialog.astro';
import DialogScript from '../components/site/DialogScript.astro';
import { faq, foreignWallets, netWorthWithForeign } from '../data/content';
import { formatMinor } from '../lib/money';
import { site } from '../data/site';

const title = 'Lucento: budget and expense tracker for Android, offline and multicurrency';
const description =
  'Track expenses, budgets, wallets, bills, goals and debts in one Android app. Works offline with no bank login, keeps wallets in several currencies, and lets two people share one budget. Free to start.';

const arrow = `<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>`;
const peso = (minor: number) => formatMinor(minor);

// The short version of the app's Privacy Policy (lucento-android feature/legal/LegalDocuments.kt, published at /privacy).
const nbsp = ' ';
const privacyRows = [
  { term: 'Your account', when: 'optional', detail: 'Your email address, a scrambled form of your password and, with Google sign-in, your Google name and picture.' },
  { term: 'Sync', when: 'Pro, with an account', detail: 'A copy of your records in Lucento’s cloud, where access rules let only your account and the people you share with open it.' },
  { term: 'Crash reports', when: 'off until you turn them on', detail: 'What went wrong in the app’s code, never amounts, names or notes.' },
  { term: 'Usage counts', when: 'off until you turn them on', detail: 'Event names and timings with a random number for this install, never amounts or what you type.' },
  { term: 'AI features (Gemini)', when: 'off until you turn them on', detail: 'Reading a message sends it with today’s date, your main currency and your category and wallet names. Asking the AI adviser sends your question with a summary of your finances, including recent transactions.' },
  { term: 'Exchange rates', when: 'on by default', detail: `When you record something in another currency: two currency codes and a date, never an amount. Off in Settings${nbsp}›${nbsp}Money.` },
  { term: 'Google Play', when: 'built into the app', detail: 'Its billing component sends Google its own diagnostics. When you buy Pro, Google takes the payment and Lucento’s server checks the purchase, never your card.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Lucento',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Android 8.0 or later',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PHP' },
    featureList: [
      'Expense and income tracking by typing, voice or receipt scanning',
      'Monthly budgets per category',
      'Multiple wallets, credit cards and loans',
      'Wallets in several currencies with exchange rates',
      'Scheduled bills and income',
      'Savings goals',
      'Insights and plain-language answers about your money',
      'Shared budget for two people',
      'Works offline, no bank login',
    ],
    ...(site.playListed ? { downloadUrl: site.playUrl, installUrl: site.playUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.flatMap((group) =>
      group.items.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
    ),
  },
];
---

<SiteLayout title={title} description={description} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" href="/screens/s-dashboard-560.avif" imagesrcset="/screens/s-dashboard-400.avif 400w, /screens/s-dashboard-560.avif 560w, /screens/s-dashboard-720.avif 720w" imagesizes="(min-width: 64em) 330px, (min-width: 48em) 300px, 60vw" fetchpriority="high" />
  </Fragment>

  <!-- 01 · Hero -->
  <section class="hero" aria-labelledby="h1">
    <div class="wrap hero-head">
      <p class="eyebrow">Personal finance for Android</p>
      <h1 id="h1">Everything about your money, <span class="accent">in one clear view.</span></h1>
      <p class="lede">Wallets, budgets, bills, goals, debts and insights, together in one app. No bank login: you record it, and Lucento keeps it straight, even offline.</p>
      <div class="hero-actions">
        <PlayCta />
        <a class="link-arrow" href="#features">Explore the features <Fragment set:html={arrow} /></a>
      </div>
      <ul class="hero-facts" aria-label="Good to know">
        <li>No bank login</li>
        <li>Works offline</li>
        <li>Free plan</li>
      </ul>
    </div>
    <HeroStage />
    <div class="hero-ground" aria-hidden="true"></div>
  </section>

  <!-- 02 · Themes (owner, 2026-11-08: straight after the hero) -->
  <ThemeStudio />

  <!-- 03 · Features (owner review 2026-11-08): the composer to try, then compact cards that open their details -->
  <section class="band" id="features" aria-labelledby="h-features">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Features</p>
        <h2 id="h-features">From today’s coffee to a loan’s last payment.</h2>
        <p class="lede">Record it fast, see it clearly, and stay ahead of it. Open any card for the details and the real screens.</p>
      </div>

      <article class="feature-panel theme-night type-panel" id="record" aria-labelledby="h-type">
        <TypeDemo />
      </article>

      <ul class="fcards">
        <li class="fcard theme-night" id="wallets">
          <FeatureGlyph kind="wallets" />
          <div class="fcard-text">
            <p class="eyebrow">Your complete picture</p>
            <h3 class="fcard-title" id="c-wallets">Everything you own, everything you owe.</h3>
            <p>Cash, banks, cards and loans side by side, adding up to one net worth.</p>
          </div>
          <a class="fcard-link" href="#about-wallets" data-dialog="about-wallets" aria-haspopup="dialog" aria-describedby="c-wallets">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night is-wide" id="multicurrency">
          <FeatureGlyph kind="fx" />
          <div class="fcard-text">
            <p class="eyebrow">Multicurrency wallets <span class="pro-tag">Pro</span></p>
            <h3 class="fcard-title" id="c-multicurrency">Every currency you hold. One total you can trust.</h3>
            <p>Dollars, dirhams and yen keep their own balances, each valued in your main currency at the rates you actually got.</p>
          </div>
          <a class="fcard-link" href="#about-multicurrency" data-dialog="about-multicurrency" aria-haspopup="dialog" aria-describedby="c-multicurrency">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night" id="intelligence">
          <FeatureGlyph kind="intel" />
          <div class="fcard-text">
            <p class="eyebrow">Understand your finances</p>
            <h3 class="fcard-title" id="c-intelligence">See where the money went.</h3>
            <p>Income against spending, month by month, with answers in plain words when you ask.</p>
          </div>
          <a class="fcard-link" href="#about-intelligence" data-dialog="about-intelligence" aria-haspopup="dialog" aria-describedby="c-intelligence">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night" id="budgeting">
          <FeatureGlyph kind="budget" />
          <div class="fcard-text">
            <p class="eyebrow">Stay within your means</p>
            <h3 class="fcard-title" id="c-budgeting">A budget that knows what’s coming.</h3>
            <p>What’s left, what’s safe to spend after bills, and how the month is pacing.</p>
          </div>
          <a class="fcard-link" href="#about-budgeting" data-dialog="about-budgeting" aria-haspopup="dialog" aria-describedby="c-budgeting">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night" id="goals">
          <FeatureGlyph kind="goals" />
          <div class="fcard-text">
            <p class="eyebrow">Build your future</p>
            <h3 class="fcard-title" id="c-goals">Goals with a pace to keep.</h3>
            <p>A target, a date if you like, and how far you’ve come.</p>
          </div>
          <a class="fcard-link" href="#about-goals" data-dialog="about-goals" aria-haspopup="dialog" aria-describedby="c-goals">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night" id="upcoming">
          <FeatureGlyph kind="ahead" />
          <div class="fcard-text">
            <p class="eyebrow">Never miss a payment</p>
            <h3 class="fcard-title" id="c-upcoming">See the bills before they land.</h3>
            <p>Bills, salary and loan payments lined up by date, with what’s overdue flagged.</p>
          </div>
          <a class="fcard-link" href="#about-upcoming" data-dialog="about-upcoming" aria-haspopup="dialog" aria-describedby="c-upcoming">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night is-wide" id="shared">
          <FeatureGlyph kind="shared" />
          <div class="fcard-text">
            <p class="eyebrow">Lucento Shared <span class="pro-tag">Pro</span></p>
            <h3 class="fcard-title" id="c-shared">Two people. One ledger.</h3>
            <p>One budget for two people, each on their own phone. Plan together, without sharing a password.</p>
          </div>
          <a class="fcard-link" href="#about-shared" data-dialog="about-shared" aria-haspopup="dialog" aria-describedby="c-shared">See the details <Fragment set:html={arrow} /></a>
        </li>
        <li class="fcard theme-night is-strip" id="offline">
          <FeatureGlyph kind="offline" />
          <div class="fcard-text">
            <p class="eyebrow">Offline or online</p>
            <h3 class="fcard-title" id="c-offline">Your phone keeps the books.</h3>
            <p>No account and no connection needed. Sign in only for the things that need one.</p>
          </div>
          <a class="fcard-link" href="#about-offline" data-dialog="about-offline" aria-haspopup="dialog" aria-describedby="c-offline">See the details <Fragment set:html={arrow} /></a>
        </li>
      </ul>

      <Dialog id="about-wallets" kicker="Your complete picture" title="Everything you own, everything you owe." night wide>
        <div class="detail">
          <div class="detail-copy">
            <p class="lede">Every place your money lives gets a wallet with its own balance, and together they add up to one honest net worth: what you have, minus what you owe.</p>
            <ul class="ticks">
              <li>Cash, bank, e-wallet and savings wallets, with logos for more than 400 banks and e-wallets</li>
              <li>Credit cards and loans beside your accounts, so what you owe is never out of sight</li>
              <li>Transfers between wallets recorded once, never counted twice</li>
              <li>Free: 3 money wallets and 2 cards or loans. Pro: as many as you need</li>
            </ul>
          </div>
          <div class="detail-art">
            <div class="feature-art is-pair">
              <Phone file="f-wallet-rows" alt="The Wallets list: net worth ₱62,120.10; Cash ₱5,630.00, Everyday bank ₱86,890.10 and Savings ₱84,000.00 under assets, and the Visa card −₱6,400.00 under liabilities." sizes="(min-width: 56em) 250px, 40vw" />
              <Phone file="f-networth" alt="What your net worth is made of: ₱62,120.10, with assets ₱176,520.10 across bank accounts, savings and cash, and liabilities ₱114,400.00 across loans and credit cards." sizes="(min-width: 56em) 250px, 40vw" />
            </div>
          </div>
        </div>
      </Dialog>

      <Dialog id="about-multicurrency" kicker="Multicurrency wallets · Pro" title="Every currency you hold. One total you can trust." night wide>
      <div class="fx-grid">
        <div>
          <div class="stack">
            <p class="lede">Keep dollars, dirhams and yen in their own wallets. Each shows its own balance and what it’s worth in your main currency, so net worth, budgets and insights all add up in one place.</p>
          </div>
          <ul class="fx-ledger">
            {
              foreignWallets.map((w) => (
                <li>
                  <span class="fx-code" aria-hidden="true">{w.currency}</span>
                  <span class="fx-name">{w.name}<small>{w.kind} · {w.currency}</small></span>
                  <span class="fx-value">
                    <span class="fx-own">{formatMinor(w.minor, { currency: w.currency })}</span>
                    <span class="fx-peso">≈ <b>{peso(w.pesoMinor)}</b> at {w.currency === 'JPY' ? `¥1 = ₱${w.rate}` : `1 ${w.currency} = ₱${w.rate}`}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="fx-total"><span class="muted">Net worth, all in pesos</span> <b>{peso(netWorthWithForeign)}</b></p>
        </div>
        <div class="fx-art">
          <Phone file="mc-rows" alt="The Wallets list with wallets in three currencies: Japan trip yen ¥60,000 ≈ ₱22,950.00, Dubai account AED4,200.00 ≈ ₱66,108.00 and Dollar savings $1,850.00 ≈ ₱106,930.00, beside the peso wallets." sizes="(min-width: 56em) 270px, 42vw" />
          <Phone file="mc-usd" alt="The Dollar savings wallet: current balance $1,850.00, about ₱106,930.00, at an average of 1 USD = 57.8 PHP, with a note that each transaction counts at its own rate and the difference on the way out is an FX gain or loss." sizes="(min-width: 56em) 270px, 42vw" />
        </div>
      </div>

      <ul class="fx-notes">
        <li><h3 class="title">Valued at its own rate</h3><p>Each movement is valued at its day’s rate and the wallet carries the average. What leaves at a different rate becomes an FX gain or loss in Insights.</p></li>
        <li><h3 class="title">Rates without your money</h3><p>Rates come from public exchange-rate services. Only two currency codes and a date are sent, never an amount; turn it off in Settings › Money.</p></li>
        <li><h3 class="title">Works offline too</h3><p>No connection? Type the rate yourself. Lucento keeps what you chose and never silently replaces it later.</p></li>
      </ul>

      </Dialog>

      <Dialog id="about-intelligence" kicker="Understand your finances" title="See where the money went." night wide>
        <div class="detail">
          <div class="detail-copy">
            <p class="lede">Insights lays out income against spending over 3, 6 or 12 months. Ask Lucento answers questions about your own figures in plain words, worked out on your phone. The AI adviser is a separate, optional step for open questions, and it says exactly what it sends.</p>
          </div>
          <div class="detail-art">
            <Phone file="s-insights" alt="Insights over the last 6 months: net +₱60,020.10 from income ₱126,000.00 and expenses −₱65,979.90, with monthly income and expense bars from June to November." sizes="(min-width: 56em) 270px, 60vw" />
          </div>
        </div>
      <ul class="tiers">
        <li class="tier">
          <h3 class="title">Insights</h3>
          <p class="muted">Income, spending and net flow by month, and what your net worth is made of.</p>
          <dl>
            <div><dt>Runs</dt><dd>On your phone, offline</dd></div>
            <div><dt>Sends</dt><dd>Nothing</dd></div>
            <div><dt>Plan</dt><dd>Last 3 months free; 6 and 12 months and net worth make-up with Pro</dd></div>
          </dl>
        </li>
        <li class="tier">
          <h3 class="title">Ask Lucento</h3>
          <p class="muted">Ask in plain words: top categories, net worth, cash flow, budget against actual, debts.</p>
          <dl>
            <div><dt>Runs</dt><dd>On your phone, offline</dd></div>
            <div><dt>Sends</dt><dd>Nothing</dd></div>
            <div><dt>Plan</dt><dd>Free; statements as PDF with Pro</dd></div>
          </dl>
        </li>
        <li class="tier">
          <h3 class="title">AI adviser <span class="muted">(Gemini)</span></h3>
          <p class="muted">Open questions about your money, answered by Google’s Gemini.</p>
          <dl>
            <div><dt>Runs</dt><dd>Online, after you sign in and turn it on</dd></div>
            <div><dt>Sends</dt><dd>Your question with a summary of your finances, including recent transactions</dd></div>
            <div><dt>Plan</dt><dd>10 questions a month free; 50 a day with Pro</dd></div>
          </dl>
        </li>
      </ul>


      </Dialog>

      <Dialog id="about-upcoming" kicker="Never miss a payment" title="See the bills before they land." night wide>
        <div class="detail">
          <div class="detail-copy">
            <p class="lede">Schedule bills, salary, transfers and loan installments once. Lucento lines them up by date, flags what’s overdue, and sets the bills aside before it tells you what’s safe to spend.</p>
            <ul class="ticks">
            <li>Upcoming income, expenses and transfers in one agenda</li>
            <li>The bell lists what’s due this week; a card payment opens already filled in</li>
            <li>Nothing is recorded until you mark it paid, so your balances stay true</li>
          </ul>
          </div>
          <div class="detail-art">
            <div class="feature-art is-pair">
          <Phone file="f-schedules" alt="All schedules: every repeating bill, salary and loan payment with how often it comes and the next date." sizes="(min-width: 56em) 250px, 40vw" />
          <Phone file="f-bell" alt="The Dashboard’s bell open on upcoming payments due this week, including the overdue fibre internet bill and the Visa card payment." sizes="(min-width: 56em) 250px, 40vw" />
        </div>
          </div>
        </div>

      </Dialog>

      <Dialog id="about-budgeting" kicker="Stay within your means" title="A budget that knows what’s coming." night wide>
        <div class="detail">
          <div class="detail-copy">
            <p class="lede">Give each category a monthly amount and your total budget is simply their sum. Lucento shows what’s left, sets the bills due aside before it tells you what’s safe to spend, and says how the month is pacing.</p>
            <ul class="ticks">
            <li>Ready-made categories grouped by how people actually spend</li>
            <li>A monthly amount per category, and a total that always adds up</li>
            <li>Pace, percentage used and what’s left, on Home and in Budget</li>
          </ul>
          </div>
          <div class="detail-art">
            <div class="feature-art is-pair">
          <Phone file="s-budget" alt="The Budget screen for November 2026: ₱2,920.10 remaining of a ₱25,900.00 budget, 89% spent with 26% of the month gone, marked Ahead of pace; ₱0.00 safe to spend because the bills due take what’s left." sizes="(min-width: 56em) 250px, 40vw" />
          <Phone file="f-categories" alt="Manage categories: the chosen spending categories, each of which can be edited or archived." sizes="(min-width: 56em) 250px, 40vw" />
        </div>
          </div>
        </div>

      </Dialog>

      <Dialog id="about-goals" kicker="Build your future" title="Goals with a pace to keep." night wide>
        <div class="detail">
          <div class="detail-copy">
            <p class="lede">Give each goal a target and, if you like, a date. Lucento shows how far you’ve come, what’s left, and the pace that gets you there on time.</p>
            <ul class="ticks">
              <li>A target and an optional date for every goal</li>
              <li>Progress, what’s still to save and a projected finish</li>
              <li>2 active goals free; up to 20 with Pro</li>
            </ul>
          </div>
          <div class="detail-art">
            <Phone file="s-goals" alt="Goals: ₱37,500.00 saved of ₱80,000.00 across 2 goals (47%), ₱42,500.00 still to save; Emergency fund ₱21,000.00 of ₱50,000.00 (42%) and Japan trip ₱16,500.00 of ₱30,000.00 (55%), each with its pace." sizes="(min-width: 56em) 270px, 60vw" />
          </div>
        </div>
      </Dialog>

      <Dialog id="about-shared" kicker="Lucento Shared · Pro" title="Two people. One ledger." night wide>
        <div class="detail">
          <div class="detail-copy">
            <p class="lede">Invite one person into your Shared Space: a partner, a parent, a housemate. Each of you keeps your own account and phone and records from it; the other sees your entries once their phone syncs, when Lucento opens or comes back to the front.</p>
            <ul class="ticks">
          <li>Only the owner needs Pro; the partner needs no plan</li>
          <li>Label wallets Shared or Personal to stay organised; labels never hide anything</li>
              <li>Your partner records as they spend; you stay in charge of the plan and the invitation</li>
          <li>Every rule here is enforced by Lucento’s server, not just the app</li>
        </ul>
          </div>
          <div class="detail-art">
            <SharedArt class="detail-shared" />
          </div>
        </div>

      </Dialog>

      <Dialog id="about-offline" kicker="Offline or online: your choice" title="Your phone keeps the books. The cloud is optional." night wide>
        <p class="lede">Lucento is built to work with no account and no connection. Sign in only for the things that need one.</p>
        <div class="lanes">
          <div class="lane lane-local">
            <p class="lane-label">On your phone · no account, no internet</p>
            <ul class="ticks">
              <li>Recording by typing, speaking or scanning</li>
              <li>Budgets, wallets, debts, goals and schedules</li>
              <li>Insights and Ask Lucento’s answers</li>
              <li>Backup files, CSV export and app lock</li>
            </ul>
          </div>
          <div class="lane lane-cloud">
            <p class="lane-label">When you sign in · only if you choose</p>
            <ul class="ticks">
              <li><span>Cloud sync between your phones <span class="pro-tag">Pro</span></span></li>
              <li><span>Restore from your account on a new phone <span class="pro-tag">Pro</span></span></li>
              <li><span>Lucento Shared with one partner <span class="pro-tag">Pro</span></span></li>
              <li>The AI adviser, and Smarter reading with Pro (Gemini)</li>
            </ul>
            <p class="fine">Exchange rates are the one lookup that’s on by default: fetched only when you record something in another currency, sending two currency codes and a date. Offline, you type the rate.</p>
          </div>
        </div>
      </Dialog>
    </div>
  </section>

  <!-- I · Security and privacy -->
  <section class="band band-haze" id="privacy" aria-labelledby="h-privacy">
    <div class="wrap">
      <div class="feature">
        <div class="feature-copy">
          <p class="eyebrow">Security and privacy</p>
          <h2 id="h-privacy">Private by default. Locked when you want.</h2>
          <p class="lede">Without an account, Lucento’s only default lookup is an exchange rate when you record another currency, and Google Play’s billing component sends Google its own diagnostics. Everything else is off until you turn it on. On the phone itself, your figures stay yours.</p>
          <ul class="safeguards">
            <li><b>Lock Lucento</b><span>Your fingerprint, face or screen lock when you open the app or come back after a minute away. It uses your phone’s own lock and stores nothing.</span></li>
            <li><b>Hide amounts</b><span>One tap blanks every amount; showing them again asks for your lock.</span></li>
            <li><b>Hide in recent apps</b><span>A blank preview when you switch apps, and no screenshots of Lucento.</span></li>
            <li><b>Backups you hold</b><span>Export a backup file or a CSV any time, on every plan. Restoring shows a preview, then merges or replaces.</span></li>
          </ul>
        </div>
        <div class="reveal-toggle">
          <div class="device">
            <div class="device-screen">
            <StatusBar file="f-shown" />
            <picture class="is-shown">
              <source type="image/avif" srcset="/screens/f-shown-400.avif 400w, /screens/f-shown-560.avif 560w, /screens/f-shown-720.avif 720w" sizes="(min-width: 56em) 290px, 60vw" />
              <img src="/screens/f-shown-560.webp" srcset="/screens/f-shown-400.webp 400w, /screens/f-shown-560.webp 560w, /screens/f-shown-720.webp 720w" sizes="(min-width: 56em) 290px, 60vw" width="720" height="1471" alt="The Dashboard with amounts showing: net wallet balance ₱62,120.10." loading="lazy" decoding="async" />
            </picture>
            <picture class="is-hidden-view">
              <source type="image/avif" srcset="/screens/f-hidden-400.avif 400w, /screens/f-hidden-560.avif 560w, /screens/f-hidden-720.avif 720w" sizes="(min-width: 56em) 290px, 60vw" />
              <img src="/screens/f-hidden-560.webp" srcset="/screens/f-hidden-400.webp 400w, /screens/f-hidden-560.webp 560w, /screens/f-hidden-720.webp 720w" sizes="(min-width: 56em) 290px, 60vw" width="720" height="1471" alt="The same Dashboard with amounts hidden: every amount is replaced by dots, while percentages and pace stay visible." loading="lazy" data-hidden-view decoding="async" />
            </picture>
            </div>
          </div>
          <label class="switch"><input type="checkbox" id="hide-amounts" role="switch" /> Hide amounts</label>
          <script>
            // The hidden view stays out of the first load; it starts loading as soon as someone reaches for the switch.
            const hiddenView = document.querySelector<HTMLImageElement>('[data-hidden-view]');
            const toggle = document.querySelector('#hide-amounts');
            const warm = () => hiddenView && (hiddenView.loading = 'eager');
            ['pointerenter', 'focus', 'touchstart'].forEach((type) => toggle?.closest('label')?.addEventListener(type, warm, { once: true, passive: true }));
            if (hiddenView && 'IntersectionObserver' in window) {
              new IntersectionObserver((entries, observer) => {
                if (entries.some((entry) => entry.isIntersecting)) { warm(); observer.disconnect(); }
              }, { rootMargin: '200px' }).observe(toggle as Element);
            }
          </script>
        </div>
      </div>

      <div class="section-head privacy-head">
        <h3 class="title-lg">What leaves your phone, and when</h3>
        <p class="muted">The short version, in the policy’s own words. The <a href="/privacy">privacy policy</a> has every detail.</p>
      </div>
      <dl class="ledger">
        {
          privacyRows.map((row) => (
            <div>
              <dt>{row.term} <span>{row.when}</span></dt>
              <dd>{row.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 05 · Pricing -->
  <section class="band" id="pricing" aria-labelledby="h-pricing">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Pricing</p>
        <h2 id="h-pricing">Free to start. Pro when you want more.</h2>
        <p class="lede">Free is a complete budget app, with no account needed. Pro removes the limits and adds the online services. Here is exactly what each plan includes.</p>
      </div>
      <Pricing />
    </div>
  </section>

  <!-- 06 · FAQ -->
  <section class="band band-haze" id="faq" aria-labelledby="h-faq">
    <div class="wrap-narrow">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 id="h-faq">Questions, answered plainly.</h2>
      </div>
      <div class="faq">
        {
          faq.map((group) => (
            <div class="faq-group">
              <h3>{group.title}</h3>
              {group.items.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          ))
        }
      </div>
      <p class="muted" style="margin-top: var(--space-8)">Still wondering? Write to <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
    </div>
  </section>

  <!-- 07 · Final call to action -->
  <section class="finale theme-night" aria-labelledby="h-finale">
    <div class="wrap finale-inner">
      <h2 id="h-finale" class="display">Coming soon <span class="accent">to Google Play.</span></h2>
      <p class="lede">Free to start, with no account and no bank login. Pro when you want more.</p>
      <div class="hero-actions">
        <PlayCta />
        <a class="link-arrow" href="#pricing">Compare the plans <Fragment set:html={arrow} /></a>
      </div>
    </div>
    <div class="hero-ground" aria-hidden="true"></div>
  </section>
  <DialogScript />
</SiteLayout>
