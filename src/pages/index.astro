---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScreenReel from '../components/ScreenReel.astro';
import { guides } from '../data/guides';
import { mascotArt } from '../data/mascot';
import { exampleMonth } from '../demo/simulator';
import { faq, limitations, realLife } from '../data/site';

const guideIds = guides.map((guide) => guide.id);
const month = exampleMonth();
const hero = mascotArt[month.pose];

function describeKeeper(pose: typeof month.pose): string {
  switch (pose) {
    case 'caution':
      return 'Lucento, a little concerned, holding the crystal torch.';
    case 'steady':
      return 'Lucento standing steady, cream scarf and crystal torch.';
    case 'greeting':
      return 'Lucento, a golden orb with a swept crest, cream scarf and satchel, holding a crystal torch.';
    default: {
      const unexpected: never = pose;
      return unexpected;
    }
  }
}

const also = [
  {
    name: 'Wallets',
    eq: 'Assets − debts = net worth',
    body: 'Cash, bank, e-wallets, savings, cards, and loans. A transfer is never income or spending. Currencies stay separate.',
  },
  {
    name: 'Bills',
    eq: 'Due, then you mark it paid',
    body: 'Rent, subscriptions, and salary. The bell shows what is overdue or due within 7 days. Nothing is recorded until you confirm.',
  },
  {
    name: 'Debts',
    eq: 'You enter the interest',
    body: 'That part is spending. The rest of the payment lowers what you owe. Lucento does not calculate the interest for you.',
  },
  {
    name: 'Goals',
    eq: 'Progress, one balance',
    body: 'A target, an optional date, and a picture. The money stays in your wallets, so it is not counted twice.',
  },
];
---

<BaseLayout
  title="Lucento — a budget tracker for Android"
  description="Lucento is an Android budget tracker in development. It sets what you’ve spent beside the month, turns a sentence into transactions, and keeps the record on your phone."
>
  <script slot="head" is:inline define:vars={{ guideIds }}>
    (function () {
      const hash = location.hash.slice(1);
      if (!hash) return;
      const toDemo = hash === 'try' || hash === 'guides' || hash.indexOf('guide-') === 0 || guideIds.indexOf(hash) !== -1;
      if (toDemo) location.replace('/demo' + (hash === 'try' ? '' : location.hash));
    })();
  </script>

  <section class="record" id="record" aria-labelledby="record-title">
    <div class="record-screen">
      <ScreenReel bleed />
    </div>
    <figure class="keeper">
      <img src={hero.still} alt={describeKeeper(month.pose)} width="512" height="512" />
      <figcaption>
        <p class="kicker">Android · in development</p>
        <h1 id="record-title">The month, beside what you’ve spent.</h1>
        <a class="demo-link" href="/demo">Try the demo</a>
      </figcaption>
    </figure>
  </section>

  <section class="ledger" id="ledger" aria-labelledby="ledger-title">
    <div class="ledger-copy">
      <p class="kicker">01 — A sentence</p>
      <h2 id="ledger-title">Write what happened.</h2>
    </div>
    <figure class="sentence">
      <p class="said">
        <span>Lunch 45,</span>
        <span>groceries 120,</span>
        <span>parking 15</span>
      </p>
      <img
        src={mascotArt.pointing.still}
        alt=""
        width="512"
        height="512"
      />
      <ol>
        <li>
          <span class="swatch food" aria-hidden="true"></span>
          <span>Lunch</span>
          <b>45.00</b>
        </li>
        <li>
          <span class="swatch groceries" aria-hidden="true"></span>
          <span>Groceries</span>
          <b>120.00</b>
        </li>
        <li>
          <span class="swatch travel" aria-hidden="true"></span>
          <span>Parking</span>
          <b>15.00</b>
        </li>
      </ol>
      <figcaption>
        Nothing is written until you tap Save. A receipt or spoken English is read on the phone. A row with no amount
        cannot be saved — Lucento does not guess a number.
        <a href="/demo#guide-add-transactions">Try it on the phone</a>
      </figcaption>
    </figure>
  </section>

  <section class="pace" id="pace" aria-labelledby="pace-title">
    <div class="pace-copy">
      <p class="kicker">02 — Pace</p>
      <h2 id="pace-title">Two bars. One month.</h2>
      <p>
        Home sets how much of the budget you’ve used beside how much of the month has passed, and says what you can
        spend a day.
      </p>
    </div>
    <div class="bars" aria-hidden="true">
      <div class="bar">
        <span style={`width:${month.used}%`}>{month.used}% used</span>
      </div>
      <div class="bar is-month">
        <span style={`width:${month.elapsed}%`}>{month.elapsed}% of the month</span>
      </div>
    </div>
    <p class="example">
      Example, {month.month}. {month.verdict}.
      {month.allowance ? ` About ${month.allowance} a day keeps this budget.` : ''} Your own month will differ. {month.spent} spent in the example.
    </p>
  </section>

  <section class="keeps" id="keeps" aria-labelledby="keeps-title">
    <div class="keeps-main">
      <h2 id="keeps-title">The record stays on the phone</h2>
      <ul>
        <li>Offline</li>
        <li>No bank login</li>
        <li>No ads, analytics, or crash reporting</li>
      </ul>
    </div>
    <div class="keeps-opt">
      <h3>Optional</h3>
      <ul>
        <li>Google or email sync</li>
        <li>Smarter reading stays off until you turn it on</li>
        <li>Then the message, date, currency, and names — never balances or history</li>
      </ul>
      <p>
        Signing out leaves the copy on the phone. Receipts are always read on the device. Pricing has not been
        announced, and Lucento is not on Google Play yet.
      </p>
    </div>
  </section>

  <section class="month" id="month" aria-labelledby="month-title">
    <h2 id="month-title">The rest of the month</h2>
    <div class="index">
      {
        also.map((item) => (
          <article>
            <h3>{item.name}</h3>
            <div>
              <p class="eq">{item.eq}</p>
              <p>{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="note">Insights show income, spending, and what net worth is made of, with the figures beside every chart.</p>
  </section>

  <section class="careful" id="careful" aria-labelledby="careful-title">
    <h2 id="careful-title">It will not guess</h2>
    <ol>
      {
        realLife.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="privacy" id="privacy" aria-labelledby="privacy-title">
    <h2 id="privacy-title">What leaves the phone</h2>
    <ul>
      <li><b>Nothing</b> until you opt in</li>
      <li><b>Sync</b> only while a Google or email account stays connected</li>
      <li><b>Smarter reading</b> only the message, date, currency, and names</li>
      <li><b>Never</b> your balances or history</li>
    </ul>
    <a class="text-link" href="/privacy">How Lucento handles your data</a>
  </section>

  <div class="split">
    <section id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
    <section id="good-to-know" aria-labelledby="limits-title">
      <h2 id="limits-title">Current limitations</h2>
      <dl class="limits">
        {
          limitations.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="close" id="get" aria-labelledby="get-title">
    <p class="kicker">03 — Availability</p>
    <h2 id="get-title">Not on Google Play yet.</h2>
    <p>Lucento is in development. Pricing has not been announced.</p>
    <a class="demo-link" href="/demo">Try the demo</a>
  </section>
</BaseLayout>

<style>
  .record {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.72fr);
    height: calc(100svh - var(--header-h));
    min-height: 36rem;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .record-screen {
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .keeper {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    margin: 0;
    min-height: 0;
    background: var(--night);
    color: var(--paper);
  }

  .keeper img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    object-position: center bottom;
  }

  .keeper figcaption {
    padding: 1rem 1.15rem 1.2rem;
    background: var(--paper);
    color: var(--ink);
  }

  .keeper h1,
  .close h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.9rem, 2.7vw, 2.8rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .demo-link {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    margin-top: 0.35rem;
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--spot);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.28em;
  }

  .ledger,
  .pace,
  .month,
  .careful,
  .split,
  .close {
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }

  .ledger {
    display: grid;
    grid-template-columns: minmax(12rem, 0.35fr) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    max-width: 92rem;
    margin: 0 auto;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .sentence {
    margin: 0;
    min-width: 0;
  }

  .said {
    display: grid;
    margin: 0;
    font-size: clamp(2.4rem, 5.4vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .sentence img {
    width: 5.5rem;
    height: 5.5rem;
    margin-top: 0.6rem;
    object-fit: contain;
  }

  .sentence ol {
    list-style: none;
    max-width: 40rem;
    margin: 0.4rem 0 0;
    padding: 0;
  }

  .sentence li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.8rem 0;
    border-top: 1px solid var(--ink);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .sentence li b {
    font-variant-numeric: tabular-nums;
    font-size: 1.35rem;
  }

  .swatch {
    width: 2.4rem;
    height: 2.4rem;
  }

  .swatch.food {
    background: #ffe9e4;
  }

  .swatch.groceries {
    background: #e3f5ec;
  }

  .swatch.travel {
    background: #e0f2fe;
  }

  figcaption,
  .note,
  .example,
  .keeps-opt p,
  .pace-copy p,
  .index p,
  .careful p {
    color: var(--quiet);
  }

  figcaption {
    max-width: 40rem;
    margin: 0.9rem 0 0;
    font-size: 1rem;
  }

  .pace {
    padding-top: 0.5rem;
    padding-bottom: clamp(2.2rem, 5vw, 3.5rem);
  }

  .pace-copy {
    max-width: 34rem;
    padding-bottom: 1.2rem;
  }

  .pace-copy p,
  .example,
  .note {
    margin: 0.7rem 0 0;
    max-width: 40rem;
  }

  .bars {
    display: grid;
    gap: 0.55rem;
    margin-left: calc(var(--page-gutter) * -1);
    margin-right: calc(var(--page-gutter) * -1);
  }

  .bar {
    height: 4.4rem;
    background: #e7eefc;
  }

  .bar span {
    display: flex;
    align-items: center;
    height: 100%;
    padding-left: var(--page-gutter);
    background: #3563f5;
    color: #fff;
    font-weight: 700;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .bar.is-month {
    background: #e7e9ef;
  }

  .bar.is-month span {
    background: var(--ink);
  }

  .example {
    padding-top: 0.9rem;
  }

  .keeps {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.8fr);
    background: var(--paper);
    color: var(--ink);
  }

  .keeps-main,
  .keeps-opt {
    padding: clamp(1.8rem, 4vw, 3rem) var(--page-gutter);
  }

  .keeps-main {
    background: var(--night);
    color: #f4f7ff;
  }

  .keeps-main h2 {
    max-width: 12ch;
  }

  .keeps-opt {
    border-top: 0.7rem solid var(--spot);
  }

  .keeps h3 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .keeps ul {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .keeps li {
    padding: 0.7rem 0;
    border-top: 1px solid currentColor;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .keeps-main li {
    border-top-color: rgba(244, 247, 255, 0.28);
  }

  .keeps-opt p {
    margin: 1rem 0 0;
    font-size: 0.98rem;
  }

  .month {
    max-width: 92rem;
    margin: 0 auto;
    padding-top: clamp(2.4rem, 6vw, 4rem);
    padding-bottom: 1rem;
  }

  .index {
    margin-top: 1.2rem;
  }

  .index article {
    display: grid;
    grid-template-columns: minmax(8rem, 0.38fr) minmax(0, 1fr);
    gap: 0.4rem 2rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-top: 1px solid var(--ink);
  }

  .index h3 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .eq {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .index article p:last-child {
    margin: 0.35rem 0 0;
  }

  .month .note {
    margin: 1rem 0 0;
  }

  .careful {
    max-width: 76rem;
    margin: 0 auto;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .careful ol {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .careful li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
  }

  .careful li span {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding-top: 0.35rem;
  }

  .careful h3 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .careful p {
    margin: 0.2rem 0 0;
  }

  .privacy {
    margin-top: clamp(2rem, 5vw, 3rem);
    padding: clamp(1.8rem, 4vw, 3rem) var(--page-gutter);
    background: var(--night);
    color: #f4f7ff;
  }

  .privacy h2 {
    max-width: 14ch;
  }

  .privacy ul {
    max-width: 40rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .privacy li {
    padding: 0.65rem 0;
    border-top: 1px solid rgba(244, 247, 255, 0.28);
    font-size: 1.15rem;
  }

  .privacy .text-link {
    color: var(--spot);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.8fr);
    gap: 1.5rem 3rem;
    max-width: 92rem;
    margin: 0 auto;
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .faq {
    margin-top: 0.8rem;
    border-top: 1px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.65rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    width: 0.7rem;
    height: 2px;
    margin-left: auto;
    flex: none;
    background: var(--ink);
    box-shadow: 0 -5px 0 var(--ink);
  }

  details[open] summary::after {
    box-shadow: none;
  }

  details p {
    margin: 0 0 0.9rem;
    color: var(--quiet);
  }

  .limits {
    margin: 0.8rem 0 0;
  }

  .limits div {
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
  }

  .limits dt {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .limits dd {
    margin: 0.2rem 0 0;
    color: var(--quiet);
  }

  .close {
    max-width: 92rem;
    margin: 0 auto;
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .close h2 {
    max-width: 12ch;
    font-size: clamp(3.2rem, 8vw, 7rem);
  }

  .close p:not(.kicker) {
    max-width: 28rem;
    margin: 0.8rem 0 0;
    font-size: 1.15rem;
    color: var(--quiet);
  }

  @media (max-width: 900px) {
    .record {
      display: block;
      height: auto;
      min-height: 0;
    }

    .record-screen {
      height: 68svh;
      min-height: 22rem;
    }

    .keeper {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .keeper img {
      height: 12rem;
      align-self: end;
    }

    .ledger,
    .keeps,
    .index article,
    .split {
      grid-template-columns: 1fr;
    }

    .ledger {
      gap: 1rem;
    }

    .sentence img {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .said {
      font-size: clamp(2.1rem, 10vw, 3rem);
    }

    .bar {
      height: 3.4rem;
    }
  }
</style>
