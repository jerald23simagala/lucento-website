---
// Homepage on the Horizon system (Phase 4). The design reference is lucento-studio lab/horizon-home.html (critic
// round 4: every gate passing); figures come from src/data/demo.ts, plans from src/data/plans.ts.
import HorizonLayout from '../layouts/HorizonLayout.astro';
import PhoneFigure from '../components/horizon/PhoneFigure.astro';
import PlayStatus from '../components/horizon/PlayStatus.astro';
import Facts from '../components/horizon/Facts.astro';
import HorizonChart from '../components/horizon/HorizonChart.astro';
import NetWorthLegend from '../components/horizon/NetWorthLegend.astro';
import Ledger from '../components/horizon/Ledger.astro';
import PlanTeaser from '../components/horizon/PlanTeaser.astro';
import ClosingBand from '../components/horizon/ClosingBand.astro';
import { demo, haveTotal, netWorth, oweTotal } from '../data/demo';
import { formatMinor } from '../lib/money';

const f = (minor: number) => formatMinor(minor, { currency: demo.currency });
const homeAlt = `The Lucento Dashboard: net wallet balance ${f(netWorth)}, wallets ${f(haveTotal)}, debts and loans ${f(-oweTotal)}, shortcuts to goals, insights, milestones, debts and scheduled bills, and the monthly budget: ${f(demo.budget.spent)} spent of ${f(demo.budget.limit)}.`;
const [lunch, groceries] = demo.composer.rows;
const composerAlt = `The Add transactions screen: the message “${demo.composer.message}” has become rows to check. ${lunch.name} ${f(lunch.minor)} under ${lunch.category} and ${groceries.name} ${f(groceries.minor)} are filled in, the reply says one of the three needs a look, and the save bar says “1 transaction is incomplete”.`;

const nbsp = ' ';
// The short version of the app's Privacy Policy (lucento-android feature/legal/LegalDocuments.kt, published at /privacy):
// one row per thing that leaves the phone, its trigger beside it, each answer short. It never claims to be complete;
// the section links to the policy for every detail (the leaked-password check, Shared invitations, retention).
const privacyRows = [
  { term: 'Your account', when: 'optional', detail: 'Your email address, a scrambled form of your password and, with Google sign-in, your Google name and picture.' },
  { term: 'Sync', when: 'Pro, with an account', detail: 'A copy of your records in Lucento’s cloud, where access rules let only your account and the people you share with open it.' },
  { term: 'Crash reports', when: 'off until you turn them on', detail: 'What went wrong in the app’s code, never amounts, names or notes.' },
  { term: 'Usage counts', when: 'off until you turn them on', detail: 'Event names and timings with a random number for this install, never amounts or what you type.' },
  { term: 'AI features (Gemini)', when: 'off until you turn them on', detail: 'Reading a message sends it with today’s date, your main currency and your category and wallet names. Asking the AI adviser sends your question with a summary of your finances, including recent transactions.' },
  { term: 'Exchange rates', when: 'on by default', detail: `For wallets in other currencies: only currency codes and dates, nothing about you or your money. Off in Settings${nbsp}›${nbsp}Money.` },
  { term: 'Google Play', when: 'built into the app', detail: 'Its billing component sends Google its own diagnostics. When you buy Pro, Google takes the payment and Lucento’s server checks the purchase, never your card.' },
];
---

<HorizonLayout
  title="Lucento: everything about your money, in one clear view"
  description="Wallets, income, expenses, budgets, savings, debts, bills and assets, together in one Android app. No bank login: you record it, and Lucento keeps it straight. Coming soon to Google Play."
>
  <Fragment slot="head">
    <!-- The panorama is the hero's largest element (a CSS background, found late without this); it is ~15 KB. The phone
         screenshot is an <img> in the HTML, so the browser finds it early without a preload. -->
    <link rel="preload" as="image" href="/brand/scenery/scenery_sunrise_panorama.webp" media="(prefers-color-scheme: light)" fetchpriority="high" />
    <link rel="preload" as="image" href="/brand/scenery/scenery_midnight_panorama.webp" media="(prefers-color-scheme: dark)" fetchpriority="high" />
  </Fragment>

  <section class="hero" aria-labelledby="h1">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="h1">
          Everything about your money<span class="tuck">,</span> <span class="keep">in one clear view<span class="tuck">.</span></span>
        </h1>
        <p class="lede">
          Wallets, income, expenses, budgets, savings, debts, bills and assets, together in one app. You record it, and Lucento keeps it straight.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href="#horizon">See the whole picture</a>
          <PlayStatus />
        </div>
        <Facts label="Good to know" items={['No bank login', 'Works offline', 'Free plan, no ads']} />
      </div>
      <PhoneFigure screen="home" alt={homeAlt} priority />
    </div>
    <div class="ground" aria-hidden="true"></div>
  </section>

  <section class="wrap section" id="horizon" aria-labelledby="h-horizon">
    <div class="section-head">
      <h2 id="h-horizon">One view of what you have and what you owe<span class="tuck">.</span></h2>
      <p class="lede">
        What you have rises above the horizon, what you owe hangs below it, and net worth is where the sun stands. Here’s the app’s demo data, drawn to one scale.
      </p>
    </div>
    <div class="horizon section-body">
      <HorizonChart have={haveTotal} owe={oweTotal} currency={demo.currency} id="chart" />
      <NetWorthLegend have={demo.have} owe={demo.owe} currency={demo.currency} />
    </div>
  </section>

  <section class="wrap section feature" id="how" aria-labelledby="h-how">
    <PhoneFigure screen="composer" alt={composerAlt} />
    <div class="feature-copy">
      <h2 id="h-how">Say what you spent<span class="tuck">.</span> Lucento does the sums<span class="tuck">.</span></h2>
      <p class="lede">
        Type “{demo.composer.message}”, or scan a receipt. It becomes rows with the amount, category and wallet filled in where Lucento can tell; anything missing is flagged, and nothing is saved until you’ve checked it.
      </p>
      <Facts label="How recording works" items={['Several at once', 'Read on your phone (Gemini reading with Pro)', 'Checked before saving']} />
    </div>
  </section>

  <section class="wrap section" id="privacy" aria-labelledby="h-privacy">
    <div class="privacy-grid">
      <div class="section-head">
        <h2 id="h-privacy">What leaves your phone<span class="tuck">,</span> and when<span class="tuck">.</span></h2>
        <p class="lede">Nothing about your money, unless you turn something on. Here’s the short version; the privacy policy has every detail.</p>
      </div>
      <div>
        <Ledger rows={privacyRows} />
        <p class="ledger-more">
          <a class="link-arrow" href="/privacy"
            >Read the privacy policy <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ><path d="M3 8h10M9 4l4 4-4 4"></path></svg
            ></a
          >
        </p>
      </div>
    </div>
    <div class="points points--two section-body">
      <div>
        <h3>Nothing to connect</h3>
        <p>Lucento never connects to a bank. You record your wallets, and logos for more than 400 banks and <span class="nowrap">e-wallets</span> come with the app, for display only.</p>
      </div>
      <div>
        <h3>Your data, in a file</h3>
        <p>Back up to a file and restore it, or export a CSV, on every plan, whenever you like.</p>
      </div>
    </div>
  </section>

  <section class="dusk section" id="plans" aria-labelledby="h-plans">
    <div class="wrap">
      <div class="section-head">
        <h2 id="h-plans">
          <span class="keep">Free to start<span class="tuck">.</span></span> <span class="keep">Pro when you want more<span class="tuck">.</span></span>
        </h2>
      </div>
      <PlanTeaser />
      <ClosingBand />
    </div>
  </section>
</HorizonLayout>
