---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lucento: financial clarity without the complexity"
  description="Lucento is a budget tracker for Android, in development. Your money stays on your phone: no bank login, no account, and it works offline."
>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">Financial clarity without the complexity.</h1>
    <p class="lede">
      Lucento is a budget tracker for Android. It keeps your money on your phone: no bank login,
      no account, and it works offline.
    </p>
    <p class="status">
      The app is still in development and isn’t on Google Play yet. This site will grow as it gets
      closer to release.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(var(--space-xxl), 10vw, 7rem) var(--page-gutter);
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(2.25rem, 6vw + 1rem, 4.5rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .lede {
    margin: var(--space-xl) 0 0;
    max-width: var(--measure);
    font-size: clamp(1.125rem, 1vw + 0.9rem, 1.375rem);
    line-height: 1.5;
  }

  .status {
    margin: var(--space-lg) 0 0;
    max-width: var(--measure);
    color: var(--on-surface-variant);
  }
</style>
