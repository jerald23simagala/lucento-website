---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import PaceCalculator from '../components/PaceCalculator.astro';
import { guides } from '../data/guides';
import { faq, howItWorks, limitations, realLife } from '../data/site';

const features = [
  {
    title: 'A budget that keeps pace',
    body: 'Give each category an amount; the month’s budget is their sum. One card compares what you’ve used with how much of the month has passed, and says what you can still spend each day.',
  },
  {
    title: 'Write it like a message',
    body: '“Lunch 45, groceries 120, parking 15” becomes three rows to check and save together. Scan a receipt or speak instead — all read on your phone.',
  },
  {
    title: 'Every wallet, honestly',
    body: 'Cash, bank, e-wallets, savings, cards and loans, with net worth as assets minus debts. Transfers are never counted as spending, and currencies are never converted behind your back.',
  },
  {
    title: 'Bills you won’t miss',
    body: 'Schedule rent, subscriptions and salary. The bell on Home shows what’s overdue or due this week; nothing is recorded until you mark it paid.',
  },
  {
    title: 'Debts paid down correctly',
    body: 'Add a card or loan with its terms. Each payment splits into principal, which lowers what you owe, and interest, which counts as spending.',
  },
  {
    title: 'Goals with a picture',
    body: 'Save toward a trip or a fund with its own image, target date and progress. The money stays in your wallets, so it’s never counted twice.',
  },
  {
    title: 'Insights from your own records',
    body: 'Income and spending trends, and what your net worth is made of. Every chart has its exact figures beside it.',
  },
  {
    title: 'Sync only if you want it',
    body: 'Back up and keep phones in step with a Google or email account. On a new phone, sign in and your data comes across.',
  },
];

const demoStories = ['add-transactions', 'scheduled', 'budget', 'new-phone'];
const strip = ['Write', 'Review', 'Save', 'Follow your pace'];
---

<BaseLayout
  title="Lucento: financial clarity without the complexity"
  description="Lucento is a budget tracker for Android, in development. Your money stays on your phone, works offline and needs no bank login. Try the app in your browser."
>
  <!-- ------------------------------------------------------------ hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="eyebrow">Budget tracker for Android</p>
      <h1 id="hero-title">Financial clarity <span>without the complexity.</span></h1>
      <p class="lede">
        Write down what you spend like a message, see at a glance whether the month is on pace, and keep every wallet,
        bill and goal in one calm place — on your phone, offline, with no bank login.
      </p>
      <div class="cta">
        <a class="button" href="#try">Try the interactive demo →</a>
        <a class="button is-quiet" href="/how-to">See the guides</a>
      </div>
      <ul class="ticks">
        <li>Works offline</li>
        <li>No bank login</li>
        <li>Nothing leaves your phone unless you sync</li>
      </ul>
    </div>
    <a class="preview" href="#try" aria-label="Open the interactive demo">
      <img src="/demo/art/mascot_thriving_greeting_happy.webp" alt="" width="220" height="220" />
      <ol class="strip" aria-hidden="true">
        {strip.map((s) => <li>{s}</li>)}
      </ol>
      <span class="preview-note">A faithful simulation of the app, with fictional money. No install needed.</span>
    </a>
  </section>

  <!-- ------------------------------------------------------------ how it works -->
  <section class="block" id="how-it-works" aria-labelledby="how-title">
    <p class="eyebrow">How it works</p>
    <h2 id="how-title">From “I just spent” to “I’m on track” in seconds</h2>
    <ol class="steps">
      {
        howItWorks.map((s, i) => (
          <li>
            <span class="step-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ------------------------------------------------------------ demo -->
  <PhoneDemo stories={demoStories} />

  <!-- ------------------------------------------------------------ real life -->
  <section class="block" id="real-life" aria-labelledby="real-title">
    <p class="eyebrow">Careful with your money</p>
    <h2 id="real-title">Built for real-life money</h2>
    <p class="section-lede">Money is messy. Lucento flags what needs you, and never guesses on your behalf.</p>
    <ul class="cards">
      {
        realLife.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))
      }
    </ul>
    <a class="text-link" href="/how-to#guide-add-transactions">Try a messy message in the guide →</a>
  </section>

  <!-- ------------------------------------------------------------ calculator -->
  <PaceCalculator />

  <!-- ------------------------------------------------------------ features -->
  <section class="block" id="features" aria-labelledby="features-title">
    <p class="eyebrow">Features</p>
    <h2 id="features-title">Everything a budget needs. Nothing it doesn’t.</h2>
    <ul class="features">
      {
        features.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ------------------------------------------------------------ guides -->
  <section class="block" id="guides" aria-labelledby="guides-title">
    <p class="eyebrow">Interactive guides</p>
    <h2 id="guides-title">Learn every task by doing it</h2>
    <p class="section-lede">Each guide runs on a simulated phone: you tap, it responds, and the step completes.</p>
    <ul class="guides">
      {
        guides.map((g, i) => (
          <li>
            <a href={`/how-to#guide-${g.id}`}>
              <span class="guide-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="guide-title">{g.title}</span>
              <span class="guide-sum">{g.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ------------------------------------------------------------ privacy -->
  <section class="block privacy" id="privacy" aria-labelledby="privacy-title">
    <p class="eyebrow">Privacy</p>
    <h2 id="privacy-title">Your money stays yours</h2>
    <ul class="facts">
      <li><strong>On your phone first.</strong> Everything is stored on the device and works without a connection.</li>
      <li><strong>No bank login, no ads.</strong> You record what you choose to record.</li>
      <li>
        <strong>Sync only if you sign in.</strong> Nothing leaves the phone until you connect a Google or email account
        and keep sync on. Signing out never deletes your data.
      </li>
      <li>
        <strong>Smarter reading is opt-in.</strong> With it on, the message you type goes to Gemini to be read — never
        your balances or history. Receipts are always read on the phone.
      </li>
    </ul>
    <a class="text-link" href="/privacy">How Lucento handles your data →</a>
  </section>

  <!-- ------------------------------------------------------------ status -->
  <section class="block status-block" id="get" aria-labelledby="get-title">
    <div>
      <p class="eyebrow">Availability</p>
      <h2 id="get-title">Coming to Google Play</h2>
      <p class="section-lede">
        Lucento is in development and isn’t on Google Play yet. Until it is, the interactive demo and guides show
        exactly how it works.
      </p>
    </div>
    <div class="cta">
      <a class="button" href="#try">Try the demo</a>
      <a class="button is-quiet" href="/how-to">Open the guides</a>
    </div>
  </section>

  <!-- ------------------------------------------------------------ FAQ -->
  <section class="block" id="faq" aria-labelledby="faq-title">
    <p class="eyebrow">FAQ</p>
    <h2 id="faq-title">Frequently asked questions</h2>
    <div class="faq">
      {
        faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ------------------------------------------------------------ limitations -->
  <section class="block" id="good-to-know" aria-labelledby="limits-title">
    <p class="eyebrow">Good to know</p>
    <h2 id="limits-title">Current limitations</h2>
    <ul class="cards is-quiet">
      {
        limitations.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="section-lede">Some are deliberate choices for your privacy; others are on the roadmap.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(var(--space-xxl), 7vw, 5.5rem) var(--page-gutter) var(--space-xl);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-xxl);
    align-items: center;
  }

  h1 {
    margin: var(--space-sm) 0 0;
    font-size: clamp(2.25rem, 5vw + 1rem, 4.25rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  h1 span {
    color: var(--primary);
  }

  .lede {
    margin: var(--space-xl) 0 0;
    max-width: var(--measure);
    font-size: clamp(1.0625rem, 0.6vw + 0.95rem, 1.25rem);
    line-height: 1.55;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch);
    padding: 0 var(--space-lg);
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .button.is-quiet {
    background: transparent;
    color: var(--primary);
    border: 1px solid var(--border-default);
  }

  .ticks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .ticks li::before {
    content: '✓ ';
    color: var(--positive);
    font-weight: 700;
  }

  .preview {
    display: grid;
    justify-items: center;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 80% 10%, color-mix(in srgb, var(--accent) 40%, transparent), transparent 60%),
      var(--surface-container-lowest);
    color: var(--on-surface);
    text-decoration: none;
  }

  .preview img {
    width: clamp(9rem, 16vw, 13rem);
    height: auto;
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strip li {
    padding: var(--space-xxs) var(--space-sm);
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    background: var(--surface);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .strip li:not(:last-child)::after {
    content: ' →';
    color: var(--on-surface-variant);
  }

  .preview-note {
    font-size: 0.875rem;
    color: var(--on-surface-variant);
    text-align: center;
  }

  .preview:hover .strip li {
    border-color: var(--primary);
  }

  .block {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-xxl) var(--page-gutter);
    scroll-margin-top: var(--space-lg);
  }

  .eyebrow {
    margin: 0;
    color: var(--primary);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h2 {
    margin: var(--space-xs) 0 0;
    max-width: 26ch;
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .section-lede {
    max-width: var(--measure);
    margin: var(--space-md) 0 0;
    color: var(--on-surface-variant);
  }

  .steps {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-md);
    counter-reset: none;
  }

  .steps li {
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--surface-container-lowest);
    border: 1px solid var(--border-default);
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 800;
  }

  .steps h3,
  .cards h3,
  .features h3 {
    margin: var(--space-sm) 0 0;
    font-size: 1.0625rem;
  }

  .steps p,
  .cards p,
  .features p {
    margin: var(--space-xs) 0 0;
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .cards {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-md);
  }

  .cards li {
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    border-left: 4px solid var(--warm-accent);
    background: var(--surface-container-lowest);
  }

  .cards.is-quiet li {
    border-left-color: var(--outline);
  }

  .cards h3 {
    margin-top: 0;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch);
    margin-top: var(--space-md);
    font-weight: 700;
  }

  .features {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }

  .features li {
    padding-top: var(--space-md);
    border-top: 2px solid var(--primary-container);
  }

  .guides {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-sm);
  }

  .guides a {
    display: block;
    height: 100%;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-container-lowest);
    color: var(--on-surface);
    text-decoration: none;
  }

  .guides a:hover {
    border-color: var(--primary);
  }

  .guide-num {
    display: block;
    color: var(--primary);
    font-weight: 800;
    font-size: 0.8125rem;
  }

  .guide-title {
    display: block;
    font-weight: 700;
  }

  .guide-sum {
    display: block;
    margin-top: var(--space-xxs);
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .facts {
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md);
    max-width: var(--measure);
  }

  .facts strong {
    display: block;
  }

  .status-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xl);
    align-items: end;
  }

  .status-block > div:first-child {
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    background: var(--hero);
    color: var(--on-hero);
  }

  .status-block .eyebrow {
    color: var(--accent);
  }

  .status-block .section-lede {
    color: var(--on-hero-muted);
  }

  .faq {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--outline-variant);
    max-width: 52rem;
  }

  details {
    border-bottom: 1px solid var(--outline-variant);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    padding: var(--space-sm) 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    margin-left: auto;
    padding-left: var(--space-md);
    color: var(--primary);
    font-size: 1.5rem;
    line-height: 1;
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    margin: 0 0 var(--space-lg);
    max-width: var(--measure);
    color: var(--on-surface-variant);
  }

  @media (max-width: 860px) {
    .hero,
    .status-block {
      grid-template-columns: 1fr;
    }
  }
</style>
