---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScreenReel from '../components/ScreenReel.astro';
import { guides } from '../data/guides';
import { faq, limitations, realLife } from '../data/site';

const guideIds = guides.map((guide) => guide.id);

const also = [
  {
    name: 'Wallets',
    eq: 'Assets − debts = net worth',
    body: 'Cash, bank, e-wallets, savings, cards, and loans. A transfer is never income or spending. Currencies stay separate.',
  },
  {
    name: 'Bills',
    eq: 'Due, then you mark it paid',
    body: 'Rent, subscriptions, and salary. The bell shows what is overdue or due within 7 days. Nothing is recorded until you confirm.',
  },
  {
    name: 'Debts',
    eq: 'You enter the interest',
    body: 'That part is spending. The rest of the payment lowers what you owe. Lucento does not calculate the interest for you.',
  },
  {
    name: 'Goals',
    eq: 'Progress, one balance',
    body: 'A target, an optional date, and a picture. The money stays in your wallets, so it is not counted twice.',
  },
];
---

<BaseLayout
  title="Lucento — a budget tracker for Android"
  description="Lucento is an Android budget tracker in development. It sets what you’ve spent beside the month, turns a sentence into transactions, and keeps the record on your phone."
>
  <script slot="head" is:inline define:vars={{ guideIds }}>
    (function () {
      const hash = location.hash.slice(1);
      if (!hash) return;
      const toDemo = hash === 'try' || hash === 'guides' || hash.indexOf('guide-') === 0 || guideIds.indexOf(hash) !== -1;
      if (toDemo) location.replace('/demo' + (hash === 'try' ? '' : location.hash));
    })();
  </script>

  <section class="open" id="pace" aria-labelledby="open-title">
    <div class="open-copy">
      <p class="kicker">Android · in development</p>
      <h1 id="open-title">The month, beside what you’ve spent.</h1>
      <p class="why">A budget tracker that keeps the record on your phone.</p>
      <a class="btn" href="/demo">Try the demo</a>
    </div>

    <ScreenReel />
  </section>

  <section class="band" aria-labelledby="sentence-title">
    <div class="band-inner">
      <h2 id="sentence-title">A sentence becomes rows</h2>
      <figure class="sentence">
        <p class="said">Lunch 45, groceries 120, parking 15</p>
        <ol>
          <li>
            <span class="swatch food" aria-hidden="true"></span>
            <span>Lunch</span>
            <b>45.00</b>
          </li>
          <li>
            <span class="swatch groceries" aria-hidden="true"></span>
            <span>Groceries</span>
            <b>120.00</b>
          </li>
          <li>
            <span class="swatch travel" aria-hidden="true"></span>
            <span>Parking</span>
            <b>15.00</b>
          </li>
        </ol>
        <figcaption>
          Nothing is written until you tap Save. A receipt or spoken English is read on the phone. A row with no amount
          cannot be saved — Lucento does not guess a number.
          <a href="/demo#guide-add-transactions">Try it on the phone</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="block" id="keeps" aria-labelledby="keeps-title">
    <h2 id="keeps-title">The record stays on the phone</h2>
    <div class="pair">
      <div class="pair-main">
        <p>On this phone</p>
        <ul>
          <li>Offline</li>
          <li>No bank login</li>
          <li>No ads, analytics, or crash reporting</li>
        </ul>
      </div>
      <div class="pair-opt">
        <p>Optional</p>
        <ul>
          <li>Google or email sync</li>
          <li>Smarter reading stays off until you turn it on</li>
          <li>Then the message, date, currency, and names — never balances or history</li>
        </ul>
      </div>
    </div>
    <p class="note">
      Signing out leaves the copy on the phone. Receipts are always read on the device. Pricing has not been announced,
      and Lucento is not on Google Play yet.
    </p>
  </section>

  <section class="block" aria-labelledby="also-title">
    <h2 id="also-title">The rest of the month</h2>
    <div class="facts">
      {
        also.map((item) => (
          <article>
            <h3>{item.name}</h3>
            <p class="eq">{item.eq}</p>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
    <p class="note">Insights show income, spending, and what net worth is made of, with the figures beside every chart.</p>
  </section>

  <section class="block trust" aria-labelledby="trust-title">
    <h2 id="trust-title">Before you rely on it</h2>
    <div class="trust-grid">
      <div id="careful">
        <h3 id="careful-title">It will not guess</h3>
        <dl>
          {
            realLife.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div id="privacy">
        <h3 id="privacy-title">What leaves the phone</h3>
        <ul class="leaves">
          <li><b>Nothing</b> until you opt in</li>
          <li><b>Sync</b> only while a Google or email account stays connected</li>
          <li><b>Smarter reading</b> only the message, date, currency, and names</li>
          <li><b>Never</b> your balances or history</li>
        </ul>
        <a class="text-link" href="/privacy">How Lucento handles your data</a>
      </div>
    </div>
  </section>

  <div class="split">
    <section id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>
    <section id="good-to-know" aria-labelledby="limits-title">
      <h2 id="limits-title">Current limitations</h2>
      <dl class="limits">
        {
          limitations.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="close" id="get" aria-labelledby="get-title">
    <div class="close-inner">
      <h2 id="get-title">Not on Google Play yet</h2>
      <p>Lucento is in development. Pricing has not been announced.</p>
      <a class="btn" href="/demo">Try the demo</a>
    </div>
  </section>
</BaseLayout>

<style>
  @font-face {
    font-family: 'Plus Jakarta Sans';
    src: url('/demo/fonts/plus_jakarta_sans_regular.ttf') format('truetype');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Plus Jakarta Sans';
    src: url('/demo/fonts/plus_jakarta_sans_semibold.ttf') format('truetype');
    font-weight: 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'Plus Jakarta Sans';
    src: url('/demo/fonts/plus_jakarta_sans_bold.ttf') format('truetype');
    font-weight: 700;
    font-display: swap;
  }

  .open,
  .block,
  .band-inner,
  .split,
  .close-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }

  .open {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.9fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-top: clamp(1.75rem, 5vh, 4.5rem);
    padding-bottom: clamp(2.5rem, 7vh, 5.5rem);
  }

  .kicker {
    font-size: 0.95rem;
    font-weight: 750;
  }

  h1 {
    margin: 0.45rem 0 0;
    max-width: 11ch;
    font-size: clamp(3.1rem, 5.6vw, 5.35rem);
    line-height: 0.92;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  h2 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .why {
    max-width: 28ch;
    margin: 1.1rem 0 0;
    font-size: clamp(1.15rem, 1.4vw, 1.35rem);
    line-height: 1.35;
    color: var(--on-surface-variant);
  }

  .open .btn {
    margin-top: 1.35rem;
  }

  figcaption,
  .note {
    max-width: 42rem;
    margin: 0.85rem 0 0;
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  figcaption a,
  .note a {
    display: inline;
  }

  .band {
    background: var(--surface-container-lowest);
    border-block: 1px solid var(--outline-variant);
  }

  .band-inner {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .said {
    margin: 1.25rem 0 0;
    max-width: 18ch;
    font-family: 'Plus Jakarta Sans', var(--font-sans);
    font-size: clamp(1.85rem, 3.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .sentence ol {
    list-style: none;
    max-width: 36rem;
    margin: 1.25rem 0 0;
    padding: 0;
    font-family: 'Plus Jakarta Sans', var(--font-sans);
  }

  .sentence li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px solid var(--outline-variant);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .sentence li b {
    font-variant-numeric: tabular-nums;
    font-size: 1.25rem;
  }

  .swatch {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.8rem;
  }

  .swatch.food {
    background: var(--category-coral-tile);
  }

  .swatch.groceries {
    background: var(--category-green-tile);
  }

  .swatch.travel {
    background: var(--category-sky-tile);
  }

  .block {
    padding-top: clamp(2.75rem, 6vw, 4.75rem);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 1.5rem;
  }

  .pair-main,
  .pair-opt {
    padding-top: 0.85rem;
  }

  .pair-main {
    border-top: 8px solid var(--mark-blue);
  }

  .pair-opt {
    border-top: 8px dashed var(--mark-sky);
  }

  .pair p {
    margin: 0;
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .pair ul {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pair li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--outline-variant);
    font-size: 1.125rem;
    font-weight: 650;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1.75rem;
    margin-top: 1.35rem;
  }

  .facts article {
    padding-top: 0.85rem;
    border-top: 1px solid var(--on-surface);
  }

  .eq {
    margin: 0.45rem 0 0;
    font-size: clamp(1.2rem, 1.4vw, 1.45rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .facts article p:last-child {
    margin: 0.45rem 0 0;
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .trust {
    padding-bottom: 0.5rem;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 2rem 3rem;
    margin-top: 1.25rem;
  }

  .trust h3 {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .trust dl,
  .limits {
    margin: 0.75rem 0 0;
  }

  .trust dl div,
  .limits div {
    padding: 0.65rem 0;
    border-top: 1px solid var(--outline-variant);
  }

  .trust dt,
  .limits dt {
    margin: 0;
    font-weight: 800;
  }

  .trust dd,
  .limits dd,
  .leaves {
    margin: 0.15rem 0 0;
    color: var(--on-surface-variant);
  }

  .leaves {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .leaves li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--outline-variant);
  }

  .leaves b {
    color: var(--on-surface);
  }

  .text-link {
    margin-top: 0.75rem;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: 1.5rem 3rem;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .faq {
    margin-top: 0.75rem;
    border-top: 1px solid var(--outline-variant);
  }

  details {
    border-bottom: 1px solid var(--outline-variant);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.85rem;
    padding: 0.55rem 0;
    font-weight: 750;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--border-focus);
    outline-offset: 2px;
  }

  summary::after {
    content: '';
    width: 0.7rem;
    height: 2px;
    margin-left: auto;
    flex: none;
    background: var(--primary);
    box-shadow: 0 -5px 0 var(--primary);
  }

  details[open] summary::after {
    box-shadow: none;
  }

  details p {
    margin: 0 0 0.85rem;
    color: var(--on-surface-variant);
  }

  .close {
    background: var(--highlight);
    color: var(--on-highlight);
  }

  .close-inner {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .close p {
    max-width: 28rem;
    margin: 0.55rem 0 0;
    font-size: 1.125rem;
  }

  .close .btn {
    margin-top: 1.1rem;
    background: var(--on-highlight);
    color: var(--highlight);
  }

  .close .btn:hover {
    background: color-mix(in srgb, var(--on-highlight) 88%, var(--midnight-navy));
  }

  @media (max-width: 980px) {
    .open {
      grid-template-columns: 1fr;
      min-height: 0;
      align-items: start;
    }

    h1 {
      max-width: 12ch;
    }

    .pair,
    .trust-grid,
    .split {
      grid-template-columns: 1fr;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
