---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import { compareGroups, planCards, priceNote, pricingFaq, type Cell } from '../data/plans';
import { mailto, site } from '../data/site';

const columns = [
  { key: 'free', label: 'Free' },
  { key: 'pro', label: 'Pro' },
  { key: 'lifetime', label: 'Pro Lifetime' },
] as const;

const cellText = (cell: Cell) => (cell === true ? 'Included' : cell === false ? 'Not included' : cell);
---

<BaseLayout
  title="Pricing — Lucento"
  description="Lucento is free, with no ads. Lucento Pro adds unlimited wallets, other currencies, cloud sync, Lucento Shared and the AI adviser — monthly, yearly with a 7-day trial, or once with Lifetime."
>
  <ContentPage
    wide
    eyebrow="Pricing"
    title="Free to start. Pro when you want more."
    lede="Everything you need to budget is free and works offline, with no account and no ads. Lucento Pro adds depth: more wallets and goals, other currencies, longer Insights, sync between phones and sharing with a partner."
  >
    <ul class="plans" aria-label="Plans">
      {
        planCards.map((plan) => (
          <li class:list={['plan', plan.id === 'pro' && 'is-featured']} aria-labelledby={`plan-${plan.id}`}>
            <h2 id={`plan-${plan.id}`}>{plan.name}</h2>
            <p class="tagline">{plan.tagline}</p>
            <p class="price">{plan.price}</p>
            <p class="price-detail">{plan.priceDetail}</p>
            <ul class="highlights">
              {plan.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="plan-note">{plan.note}</p>
          </li>
        ))
      }
    </ul>
    <p class="fine">{priceNote}</p>

    <div class="get">
      {
        site.playListed ? (
          <a class="get-btn" href={site.playUrl}>
            Get Lucento on Google Play
          </a>
        ) : (
          <p class="get-soon">
            <strong>Coming soon to Google Play.</strong> Lucento Pro is bought inside the app, through Google Play.
          </p>
        )
      }
      <a class="get-link" href="/#try">Try the demo in your browser</a>
    </div>

    <section class="cloud" aria-labelledby="cloud">
      <h2 id="cloud">Lucento Cloud, for Lifetime owners</h2>
      <p>
        The online services — cloud sync, restore from your account, Lucento Shared, the AI adviser at 50 questions a
        day and Smarter reading — for people who own Lucento, after Lifetime’s included 12 months. ₱59 a month or ₱490
        a year; optional, and cancelled in Google Play like any subscription. Stopping it pauses sync and returns the
        adviser to 10 questions a month. Everything you own is untouched.
      </p>
    </section>

    <section aria-labelledby="compare">
      <h2 id="compare">Compare the plans</h2>
      {/* A named region that scrolls sideways on a phone must take keyboard focus, or it can't be scrolled without a
          mouse (WCAG 2.1.1; axe "scrollable-region-focusable"). */}
      {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
      <div class="table-scroll" role="region" aria-labelledby="compare" tabindex="0">
        <table>
          <caption class="visually-hidden">What each plan includes</caption>
          <thead>
            <tr>
              <th scope="col">What you can do</th>
              {columns.map((c) => <th scope="col">{c.label}</th>)}
            </tr>
          </thead>
          {
            compareGroups.map((group) => (
              <tbody>
                <tr class="group">
                  <th scope="colgroup" colspan="4">
                    {group.title}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.what}</th>
                    {columns.map((c) => {
                      const cell = row[c.key];
                      return typeof cell === 'boolean' ? (
                        <td class:list={['mark', cell ? 'is-yes' : 'is-no']}>
                          <span aria-hidden="true">{cell ? '✓' : '—'}</span>
                          <span class="visually-hidden">{cellText(cell)}</span>
                        </td>
                      ) : (
                        <td>{cell}</td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
    </section>

    <section aria-labelledby="faq">
      <h2 id="faq">Questions about plans</h2>
      <div class="faq">
        {
          pricingFaq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <p class="fine">
        Subscriptions renew automatically until cancelled in
        <a href={site.manageSubscriptionsUrl}>Google Play › Subscriptions</a>. Read the
        <a href="/terms">Terms of Use</a> and the <a href="/privacy">Privacy Policy</a>. Anything else:
        <a href={mailto('Question about Lucento Pro')}>{site.contactEmail}</a>.
      </p>
    </section>
  </ContentPage>
</BaseLayout>

<style>
  .plans {
    list-style: none;
    margin: var(--space-xxl) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-lg);
    background: var(--surface-container-lowest);
  }

  .plan.is-featured {
    border: 2px solid var(--primary);
    box-shadow: var(--shadow-md);
  }

  .plan h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .tagline {
    margin: var(--space-xs) 0 0;
    color: var(--on-surface-variant);
  }

  .price {
    margin: var(--space-lg) 0 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .price-detail {
    margin: var(--space-xxs) 0 0;
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .highlights {
    margin: var(--space-lg) 0 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-xs);
    font-size: 0.9375rem;
  }

  .plan-note {
    margin: auto 0 0;
    padding-top: var(--space-lg);
    color: var(--on-surface-variant);
    font-size: 0.875rem;
  }

  .fine {
    margin: var(--space-md) 0 0;
    color: var(--on-surface-variant);
    font-size: 0.875rem;
  }

  .get {
    margin: var(--space-xl) 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
  }

  .get-btn {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--space-xl);
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--on-primary) !important;
    font-weight: 600;
    text-decoration: none;
  }

  .get-soon {
    margin: 0;
  }

  .get-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 600;
  }

  .cloud {
    margin-top: var(--space-xxl);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    background: var(--surface-container);
  }

  .cloud h2 {
    margin-top: 0;
  }

  .cloud p {
    margin: var(--space-sm) 0 0;
    max-width: 60rem;
  }

  .table-scroll {
    /* Contains the cells' visually hidden labels (position: absolute), which would otherwise widen the page. */
    position: relative;
    margin-top: var(--space-lg);
    overflow-x: auto;
    border: 1px solid var(--outline-variant);
    border-radius: var(--radius-lg);
  }

  .table-scroll:focus-visible {
    outline: 3px solid var(--border-focus);
    outline-offset: 2px;
  }

  table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--outline-variant);
  }

  thead th {
    border-top: 0;
    background: var(--surface-container-low);
    font-size: 0.875rem;
  }

  tbody th[scope='row'] {
    font-weight: 400;
    width: 44%;
  }

  tr.group th {
    padding-top: var(--space-lg);
    font-weight: 700;
    background: var(--surface-container-lowest);
  }

  td.mark {
    font-weight: 700;
  }

  td.is-yes {
    color: var(--positive);
  }

  td.is-no {
    color: var(--on-surface-variant);
  }

  .faq {
    margin-top: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
  }

  details {
    border-bottom: 1px solid var(--outline-variant);
  }

  summary {
    min-height: 48px;
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
  }

  details p {
    margin: 0 0 var(--space-md);
    color: var(--on-surface-variant);
  }
</style>
