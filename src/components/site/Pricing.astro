---
/**
 * Plans and the full Free / Pro / Lifetime comparison, from src/data/plans.ts (approved customer copy; limits mirror
 * lucento-android PlanCatalog: 3 money wallets and 2 cards or loans free, 2 → 20 goals, 10 AI questions a month free →
 * 50 a day, 3 → 6 and 12 months of Insights, one Shared partner, two → five themes). Prices are Google Play's
 * indicative Philippine prices; the app only ever shows Play's own price.
 *
 * Owner review (2026-11-08): Pro opens on yearly billing with its saving shown (a radio switch, no JavaScript needed),
 * Lifetime gets Pro's premium treatment, and the full comparison opens in a dialog instead of unfolding the page.
 */
import { compareGroups, planCards, priceNote, proBilling, type Cell } from '../../data/plans';
import { formatPrice, yearlySaving } from '../../lib/money';
import Dialog from './Dialog.astro';

const saving = yearlySaving(proBilling.monthlyMinor, proBilling.yearlyMinor);
const perMonth = formatPrice(Math.floor(proBilling.yearlyMinor / 12 / 100) * 100);
const featureCount = compareGroups.reduce((sum, g) => sum + g.rows.length, 0);

const cell = (value: Cell) =>
  value === true ? { text: 'Included', cls: 'yes', mark: '✓' } : value === false ? { text: 'Not included', cls: 'no', mark: '—' } : { text: value, cls: '', mark: value };
const plans = [
  { key: 'free', label: 'Free' },
  { key: 'pro', label: 'Pro' },
  { key: 'lifetime', label: 'Lifetime' },
] as const;
---

<div class="plans">
  {
    planCards.map((plan) => (
      <article class:list={['plan', `plan-${plan.id}`, plan.id !== 'free' && 'is-pro']} aria-labelledby={`plan-${plan.id}`}>
        <div class="stack">
          <div class="plan-title">
            <h3 id={`plan-${plan.id}`}>{plan.name}</h3>
            {plan.id === 'pro' && <span class="plan-flag">{proBilling.trialDays}-day free trial</span>}
            {plan.id === 'lifetime' && <span class="plan-flag is-sun">Pay once</span>}
          </div>
          <p class="muted">{plan.tagline}</p>
        </div>
        {plan.id === 'pro' ? (
          <div class="billing-wrap">
            <fieldset class="billing">
              <legend class="sr-only">Billing</legend>
              <label>
                <input type="radio" name="pro-billing" value="yearly" checked />
                <span>Yearly</span>
                <span class="save-pill">Save {saving.percent}%</span>
              </label>
              <label>
                <input type="radio" name="pro-billing" value="monthly" />
                <span>Monthly</span>
              </label>
            </fieldset>
            <div class="price-yearly">
              <p class="plan-price"><b>{formatPrice(proBilling.yearlyMinor)}</b><span>a year</span></p>
              <p class="fine">About {perMonth} a month. Starts with a {proBilling.trialDays}-day free trial.</p>
              <p class="saving">{formatPrice(saving.savedMinor)} less than paying monthly for a year</p>
            </div>
            <div class="price-monthly">
              <p class="plan-price"><b>{formatPrice(proBilling.monthlyMinor)}</b><span>a month</span></p>
              <p class="fine">Billed every month. Cancel any time in Google Play.</p>
              <p class="saving is-quiet">Switch to yearly and pay {formatPrice(saving.savedMinor)} less a year</p>
            </div>
          </div>
        ) : (
          <div>
            <p class="plan-price">
              <b>{formatPrice(plan.id === 'lifetime' ? proBilling.lifetimeMinor : 0)}</b>
              <span>{plan.id === 'lifetime' ? 'once' : 'forever'}</span>
            </p>
            <p class="fine">{plan.priceDetail}</p>
          </div>
        )}
        <ul class="ticks">
          {plan.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {plan.id === 'pro' ? (
          <p class="plan-note">
            <span class="note-yearly">{plan.note}</span>
            <span class="note-monthly">Renews every month until you cancel in Google Play.</span>
          </p>
        ) : (
          <p class="plan-note">{plan.note}</p>
        )}
      </article>
    ))
  }
</div>
<p class="fine" style="margin-top: var(--space-4)">{priceNote}</p>

<div class="after">
  <div>
    <h3>After you buy</h3>
    <p>Pro switches on as soon as Google Play confirms the purchase, and comes back automatically on any phone that uses the same Google account. Pro renews monthly or yearly until you cancel in Google Play; Lifetime is one payment, never renewed.</p>
  </div>
  <div>
    <h3>If Pro ends</h3>
    <p>Nothing is deleted or hidden. Wallets and goals beyond the free limits stay and stay editable; the limits only apply to adding new ones. Cloud sync pauses and picks up again if you come back.</p>
  </div>
  <div>
    <h3>Lifetime, plainly</h3>
    <p>Every Pro feature that runs on your phone is yours for good, including future ones. Online services (sync, restore, Shared, the AI adviser at the Pro allowance) are included for 12 months, then continue with Lucento Cloud at ₱59 a month or ₱490 a year, or not at all.</p>
  </div>
</div>

<div class="compare-cta">
  <div>
    <h3 class="title">Every feature, plan by plan</h3>
    <p class="muted">All {featureCount} features side by side across Free, Pro and Lifetime.</p>
  </div>
  <a class="btn btn-ghost" href="#compare" data-dialog="compare" aria-haspopup="dialog">Compare the plans</a>
</div>

<Dialog id="compare" title="Compare the plans" wide>
  <table class="compare">
    <caption class="sr-only">Every feature on Free, Pro and Lifetime</caption>
    <thead>
      <tr>
        <th scope="col">What you get</th>
        {plans.map((p) => <th scope="col">{p.label}</th>)}
      </tr>
    </thead>
    {
      compareGroups.map((group) => (
        <tbody>
          <tr>
            <th scope="rowgroup" colspan="4">{group.title}</th>
          </tr>
          {group.rows.map((row) => (
            <tr>
              <th scope="row">{row.what}</th>
              {plans.map((p) => {
                const c = cell(row[p.key]);
                return (
                  <td class={c.cls} data-plan={p.label}>
                    {c.cls ? (
                      <>
                        <span aria-hidden="true">{c.mark}</span>
                        <span class="sr-only">{c.text}</span>
                      </>
                    ) : (
                      c.text
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
  <p class="fine" style="margin-top: var(--space-4)">{priceNote}</p>
</Dialog>
