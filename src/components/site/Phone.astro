---
/**
 * A real Lucento screen in a phone frame. Screens are API 36 captures (peso demo month) cropped by lucento-studio
 * qa/crop-screen.mjs into 400/560/720 px wide AVIF and WebP files in /public/screens.
 */
import { SCREEN_H, SCREEN_W } from '../../data/content';

interface Props {
  file: string;
  alt: string;
  /** CSS width the frame is laid out at, for `sizes`. */
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { file, alt, sizes = '(min-width: 64em) 330px, 66vw', eager = false, class: extra } = Astro.props;
const set = (format: 'avif' | 'webp') => [400, 560, 720].map((w) => `/screens/${file}-${w}.${format} ${w}w`).join(', ');
---

<div class:list={['device', extra]}>
  <picture>
    <source type="image/avif" srcset={set('avif')} sizes={sizes} />
    <img
      src={`/screens/${file}-560.webp`}
      srcset={set('webp')}
      sizes={sizes}
      width={SCREEN_W}
      height={SCREEN_H}
      alt={alt}
      decoding="async"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </picture>
</div>
