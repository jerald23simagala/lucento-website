---
/**
 * The Google Play call to action. Until the listing is public (site.playListed, owner decision 2026-11-08) it is a
 * status, not a link: "Coming soon to Google Play". The day playListed is true it becomes the download link. Before
 * launch, swap this styling for Google's official "Get it on Google Play" badge artwork, which its brand rules require
 * for store links.
 *
 * The link carries tags that tell Play Console which button sent the install (src/lib/play-link.ts, CRO-3). They are in
 * the HTML, so they work without JavaScript. The script below only swaps in the visitor's own source when they arrived
 * from a tagged post.
 */
import { site } from '../../data/site';
import { playLink, type PlayPlace } from '../../lib/play-link';

interface Props {
  /** Which button this is, as Play Console will name it (website_<place>). */
  place: PlayPlace;
  /** Smaller, for the header. */
  compact?: boolean;
}
const { place, compact = false } = Astro.props;
const mark = `<svg viewBox="0 0 26 28" aria-hidden="true" focusable="false"><path fill="#00D7FE" d="M1.2.6C.8 1 .6 1.6.6 2.4v23.2c0 .8.2 1.4.6 1.8l.1.1 13-13v-.3L1.3.5z"/><path fill="#FFCE00" d="m18.6 18.9-4.3-4.3v-.3l4.3-4.3.1.1 5.1 2.9c1.5.8 1.5 2.2 0 3l-5.1 2.9z"/><path fill="#FF3A44" d="M18.7 18.8 14.3 14.4 1.2 27.5c.5.5 1.3.6 2.2.1l15.3-8.8"/><path fill="#48FF48" d="M18.7 10 3.4 1.3C2.5.8 1.7.9 1.2 1.4l13.1 13z"/></svg>`;
---

{
  site.playListed ? (
    <a class:list={['play', compact && 'is-compact']} href={playLink(site.playUrl, place)} data-play-place={place}>
      <Fragment set:html={mark} />
      <span>
        <small>Get it on</small>
        <b>Google Play</b>
      </span>
    </a>
  ) : (
    <p class:list={['play', 'is-soon', compact && 'is-compact']}>
      <Fragment set:html={mark} />
      <span>
        <small>Coming soon to</small>
        <b>Google Play</b>
      </span>
    </p>
  )
}

<script>
  import { site } from '../../data/site';
  import { asPlace, incomingFrom, playLink, type IncomingTags } from '../../lib/play-link';

  // The visitor's own tags, kept in this tab only, so a second page of the visit still credits the post they came from.
  const KEY = 'lucento.play-tags';
  let incoming: IncomingTags | null = incomingFrom(location.search);
  try {
    if (incoming) sessionStorage.setItem(KEY, JSON.stringify(incoming));
    else incoming = JSON.parse(sessionStorage.getItem(KEY) ?? 'null') as IncomingTags | null;
  } catch {
    // Storage off or unreadable: the links keep their plain website tags.
  }
  if (incoming) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-play-place]')) {
      const place = asPlace(link.dataset.playPlace);
      // playLink checks each tag again, so a value changed in storage can only fall back to the defaults.
      if (place) link.href = playLink(site.playUrl, place, incoming);
    }
  }
</script>
