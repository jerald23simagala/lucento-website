---
/**
 * Lucento Shared, drawn (owner review, 2026-11-08: "two people's hands on phones"): two hands, each holding a phone
 * open on the same Shared Space ledger, joined by a sync arc. Original vector art in the Sunrise palette; decorative
 * (the card and the dialog say everything in words). The newest row lights up on both phones at once, which is the
 * point: one ledger, two phones. The light stays put under reduced motion.
 */
interface Props {
  class?: string;
}
const { class: extra } = Astro.props;

// One phone with its hand, drawn in the phone's own coordinates (150 × 270) so the hand turns with it.
const rows = [
  { who: 'Y', fill: '#3563F5', w: 58 },
  { who: 'P', fill: '#FF8A24', w: 44 },
  { who: 'Y', fill: '#3563F5', w: 66 },
  { who: 'P', fill: '#FF8A24', w: 50 },
];
const screen = (side: 'a' | 'b') => `
  <rect x="8" y="10" width="134" height="250" rx="16" fill="#10182B"/>
  <rect x="58" y="16" width="34" height="7" rx="3.5" fill="#05070d"/>
  <text x="20" y="46" font-size="11" font-weight="800" fill="#F8FAFF" letter-spacing="-0.2">Shared Space</text>
  <g transform="translate(108 36)"><circle r="8" fill="#3563F5"/><circle cx="10" r="8" fill="#FF8A24" stroke="#10182B" stroke-width="2"/></g>
  <rect x="20" y="58" width="110" height="34" rx="9" fill="#202E4D"/>
  <rect x="28" y="66" width="38" height="5" rx="2.5" fill="#B8C5DC" opacity=".7"/>
  <rect x="28" y="76" width="62" height="8" rx="4" fill="#F8FAFF"/>
  ${rows
    .map(
      (r, i) => `
  <g transform="translate(20 ${104 + i * 34})" class="${i === 0 ? `sa-new sa-new-${side}` : ''}">
    <rect width="110" height="28" rx="8" fill="${i === 0 ? '#26397A' : '#17233F'}"/>
    <circle cx="14" cy="14" r="8" fill="${r.fill}"/>
    <text x="14" y="17.5" font-size="9" font-weight="800" fill="#fff" text-anchor="middle">${r.who}</text>
    <rect x="28" y="8" width="${r.w}" height="5" rx="2.5" fill="#F8FAFF" opacity=".85"/>
    <rect x="28" y="17" width="${r.w - 14}" height="4" rx="2" fill="#B8C5DC" opacity=".5"/>
    <rect x="${102 - 18}" y="11" width="18" height="6" rx="3" fill="#FF8A8A"/>
  </g>`,
    )
    .join('')}
`;

const hand = (skin: string, shade: string, sleeve: string, cuff: string) => ({
  // behind the phone: forearm, sleeve and palm
  back: `
    <path d="M22 262 C 18 300, 16 330, 14 360 L 128 360 C 126 330, 124 300, 120 262 Z" fill="${skin}"/>
    <path d="M8 304 C 46 314, 98 314, 136 302 L 142 360 L 2 360 Z" fill="${sleeve}"/>
    <path d="M8 304 C 46 314, 98 314, 136 302 L 137 314 C 98 326, 46 326, 9 316 Z" fill="${cuff}"/>
    <ellipse cx="74" cy="248" rx="70" ry="44" fill="${skin}"/>
    <path d="M118 236 C 132 236, 146 224, 150 206 L 154 136 C 155 126, 146 122, 140 128 L 120 150 Z" fill="${skin}"/>
    <rect x="132" y="126" width="24" height="112" rx="12" fill="${skin}"/>`,
  // in front: four fingertips curling over the right edge, the thumb over the left
  front: `
    <rect x="138" y="132" width="21" height="19" rx="9.5" fill="${skin}"/>
    <rect x="139" y="155" width="22" height="19" rx="9.5" fill="${skin}"/>
    <rect x="138" y="178" width="21" height="19" rx="9.5" fill="${skin}"/>
    <rect x="136" y="201" width="19" height="18" rx="9" fill="${skin}"/>
    <path d="M152 141.5 h4 M154 164.5 h4 M153 187.5 h4 M150 210 h3" stroke="${shade}" stroke-width="2" stroke-linecap="round" opacity=".5"/>
    <g transform="translate(14 252) rotate(-58)">
      <rect x="-8" y="-12.5" width="70" height="25" rx="12.5" fill="${skin}"/>
      <path d="M50 -6 a7 7 0 0 1 0 12" stroke="${shade}" stroke-width="2" fill="none" stroke-linecap="round" opacity=".5"/>
    </g>`,
});

const phone = (side: 'a' | 'b') => `
  <rect x="0" y="0" width="150" height="270" rx="22" fill="#0B1222"/>
  <rect x="0.75" y="0.75" width="148.5" height="268.5" rx="21.25" fill="none" stroke="#3A4766" stroke-width="1.5"/>
  ${screen(side)}`;

const left = hand('#E0A27A', '#9C5F3C', '#3563F5', '#2447C7');
const right = hand('#8A5638', '#4E2C1A', '#FF8A24', '#C9661A');
---

<svg class:list={['shared-art', extra]} viewBox="50 0 460 392" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="sa-clip"><rect x="50" width="460" height="392" /></clipPath>
    <linearGradient id="sa-arc" x1="0" x2="1">
      <stop offset="0" stop-color="#7C9AFF" />
      <stop offset="1" stop-color="#FFC928" />
    </linearGradient>
  </defs>
  <g clip-path="url(#sa-clip)">
    <!-- the sync arc between the two phones -->
    <path d="M214 52 C 244 10, 316 10, 346 52" fill="none" stroke="url(#sa-arc)" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9" />
    <path d="M208 44 l6 9 l9 -5" fill="none" stroke="#7C9AFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M352 44 l-6 9 l-9 -5" fill="none" stroke="#FFC928" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <g transform="translate(280 18)">
      <rect x="-50" y="-15" width="100" height="30" rx="15" fill="#17233F" stroke="#2D3D63" />
      <text y="5" font-size="12" font-weight="800" fill="#F8FAFF" text-anchor="middle">One ledger</text>
    </g>

    <!-- left: you -->
    <g transform="translate(96 54) rotate(-9 75 135)">
      <Fragment set:html={left.back} />
      <Fragment set:html={phone('a')} />
      <Fragment set:html={left.front} />
    </g>
    <!-- right: your partner (mirrored, so the thumb is on the outside) -->
    <g transform="translate(464 54) scale(-1 1) rotate(-9 75 135)">
      <Fragment set:html={right.back} />
      <g transform="translate(150 0) scale(-1 1)"><Fragment set:html={phone('b')} /></g>
      <Fragment set:html={right.front} />
    </g>
  </g>
</svg>
