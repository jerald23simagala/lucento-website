---
/**
 * A feature card's icon (owner review 3, 2026-11-08: identical one-line cards with icons; the details and the real
 * screens open on click). Plain 24-unit line icons in the text colour of the chip; decorative, so hidden from
 * assistive tech: the card's title names the feature.
 */
export type FeatureIconKind = 'wallets' | 'budget' | 'upcoming' | 'goals' | 'insights' | 'fx' | 'shared' | 'offline' | 'privacy';
interface Props {
  kind: FeatureIconKind;
}
const { kind } = Astro.props;
const paths: Record<FeatureIconKind, string> = {
  wallets: '<path d="M5 7V6a2 2 0 0 1 2-2h10"/><rect x="3" y="7" width="18" height="13" rx="2.5"/><path d="M15.5 13.5h2"/>',
  budget: '<path d="M11 4a8 8 0 1 0 9 9h-9z"/><path d="M14 3.2A8 8 0 0 1 20.8 10H14z"/>',
  upcoming: '<rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4M8 14.5h3"/>',
  goals: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.6" fill="currentColor"/>',
  insights: '<path d="M4 20h16M7 16v-4M12 16V7M17 16v-7"/>',
  fx: '<path d="M4 8.5h14l-3.5-3.5M20 15.5H6l3.5 3.5"/>',
  shared: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="16.5" cy="9.5" r="2.6"/><path d="M16 14.6a4.5 4.5 0 0 1 4.5 4.9"/>',
  offline: '<rect x="6.5" y="3" width="11" height="18" rx="2.5"/><path d="M10.5 17.5h3"/>',
  privacy: '<path d="M12 3 19.5 6v5.5c0 4.5-3.2 8.2-7.5 9.5-4.3-1.3-7.5-5-7.5-9.5V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
};
---

<span class="ficon" aria-hidden="true"
  ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={paths[kind]} /></span
>
