---
/**
 * Gentle section reveals (owner, round 2, 2026-11-13): below the first screen, section heads, cards, plans and FAQ
 * entries ease in once as they arrive, in short staggers. Nothing visible at load waits; without JavaScript, or with
 * reduced motion, nothing is hidden at all (the hidden state is added here, never in the markup). Also wakes the lead
 * card's replica preview only while it is on screen.
 */
---

<script>
  const preview = document.querySelector('.lead-preview');
  if (preview && 'IntersectionObserver' in window) {
    new IntersectionObserver((entries) => entries.forEach((e) => e.target.classList.toggle('is-awake', e.isIntersecting))).observe(preview);
  }
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!calm && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('rv-in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll<HTMLElement>('main .section-head, .studio-controls, .fcards > li, .plans > *, #faq details').forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
      const i = el.parentElement ? [...el.parentElement.children].indexOf(el) : 0;
      el.style.setProperty('--rv-d', `${(i % 3) * 80}ms`);
      el.classList.add('rv');
      io.observe(el);
    });
  }
</script>
