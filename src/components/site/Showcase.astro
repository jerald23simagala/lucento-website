---
/**
 * The hero's six real screens in a horizontal scroll-snap track: swipe on a phone, click a tab or use the arrow keys
 * on a computer. The centred screen is full size and its neighbours sit back on either side. Without JavaScript the
 * track still scrolls and every tab still jumps to its screen; the script only keeps the tabs, the caption and the
 * emphasis in step with the scroll position.
 */
import Phone from './Phone.astro';
import { screens } from '../../data/content';

const first = screens[0];
---

<div class="showcase" data-showcase>
  {/* A region that scrolls sideways must take keyboard focus, or it can't be scrolled without a mouse
      (WCAG 2.1.1; axe "scrollable-region-focusable"). The arrow keys then move between screens. */}
  {/* eslint-disable-next-line astro/jsx-a11y/no-noninteractive-tabindex */}
  <div class="showcase-track" data-track tabindex="0" role="region" aria-label="Six Lucento screens. Scroll sideways or use the buttons below.">
    {
      screens.map((screen, i) => (
        <figure class:list={['slide', i === 0 && 'is-active', i === 1 && 'is-near']} id={`screen-${screen.id}`} data-slide={screen.id} data-title={screen.title} data-text={screen.caption}>
          <Phone file={screen.file} alt={screen.alt} eager={i === 0} sizes="(min-width: 64em) 330px, (min-width: 48em) 300px, 66vw" />
          <figcaption class="sr-only">{screen.label}</figcaption>
        </figure>
      ))
    }
  </div>
  <nav class="showcase-tabs" aria-label="Choose a screen">
    {
      screens.map((screen, i) => (
        <a href={`#screen-${screen.id}`} data-tab={screen.id} aria-current={i === 0 ? 'true' : 'false'}>
          {screen.label}
        </a>
      ))
    }
  </nav>
  <p class="showcase-caption" data-caption aria-live="polite"><b>{first.title}.</b> {first.caption}</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  const track = root?.querySelector<HTMLElement>('[data-track]');
  if (root && track) {
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;

    const set = (index: number) => {
      if (index === active && slides[index].classList.contains('is-active')) return;
      active = index;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        slide.classList.toggle('is-near', Math.abs(i - index) === 1);
      });
      tabs.forEach((tab, i) => tab.setAttribute('aria-current', String(i === index)));
      const slide = slides[index];
      if (caption) {
        caption.replaceChildren();
        const b = document.createElement('b');
        b.textContent = `${slide.dataset.title}.`;
        caption.append(b, ` ${slide.dataset.text}`);
      }
      // Keep the chosen tab in view in the scrolling tab row (phones), without moving the page.
      const tab = tabs[index];
      const row = tab.parentElement;
      if (row && row.scrollWidth > row.clientWidth) {
        row.scrollTo({ left: tab.offsetLeft - (row.clientWidth - tab.offsetWidth) / 2, behavior: reduce.matches ? 'auto' : 'smooth' });
      }
    };

    // The slide nearest the track's centre is the active one.
    let frame = 0;
    const measure = () => {
      frame = 0;
      const mid = track.getBoundingClientRect().left + track.clientWidth / 2;
      let best = 0;
      let bestDistance = Infinity;
      slides.forEach((slide, i) => {
        const box = slide.getBoundingClientRect();
        const distance = Math.abs(box.left + box.width / 2 - mid);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });
      set(best);
    };
    track.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(measure);
    }, { passive: true });

    const go = (index: number, instant = false) => {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, index))];
      const left = slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2;
      track.scrollTo({ left, behavior: instant || reduce.matches ? 'auto' : 'smooth' });
    };
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        go(i);
        set(i);
      }),
    );
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        go(active + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    // A click on a neighbour brings it to the centre.
    slides.forEach((slide, i) => slide.addEventListener('click', () => i !== active && go(i)));
    window.addEventListener('resize', () => go(active, true));
  }
</script>
