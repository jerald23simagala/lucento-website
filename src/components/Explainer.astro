---
// Short product loop rendered with Remotion into public/video.
// The page figures are the still explanation; this only plays when motion is allowed.
import { existsSync } from 'node:fs';

const ready =
  existsSync('public/video/explainer.mp4') &&
  existsSync('public/video/explainer.webm') &&
  existsSync('public/video/explainer-poster.webp');
---

{
  ready && (
    <figure class="explainer">
      <video
        class="explainer-video"
        poster="/video/explainer-poster.webp"
        muted
        playsinline
        loop
        preload="none"
        width="640"
        height="360"
        data-explainer
      />
      <figcaption>
        A silent loop of the pace bars, a sentence becoming rows, and optional sync. It stays on this still if you prefer
        reduced motion.
      </figcaption>
    </figure>
  )
}

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-explainer]');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const disarm = (): void => {
      video.pause();
      video.querySelectorAll('source').forEach((source) => source.remove());
      video.removeAttribute('src');
      video.load();
      delete video.dataset.armed;
    };

    const arm = (): void => {
      if (reduce.matches || video.dataset.armed === 'true') return;
      video.dataset.armed = 'true';
      const webm = document.createElement('source');
      webm.src = '/video/explainer.webm';
      webm.type = 'video/webm';
      const mp4 = document.createElement('source');
      mp4.src = '/video/explainer.mp4';
      mp4.type = 'video/mp4';
      video.append(webm, mp4);
      video.load();
      void video.play().catch(() => {});
    };

    if (!reduce.matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          arm();
          observer.disconnect();
        },
        { rootMargin: '160px' },
      );
      observer.observe(video);
    }

    reduce.addEventListener('change', () => {
      if (reduce.matches) disarm();
      else arm();
    });
  }
</script>

<style>
  .explainer {
    margin: 1.25rem 0 0;
  }

  .explainer-video {
    display: block;
    width: min(40rem, 100%);
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--surface-container-low);
    border-radius: var(--radius-md);
  }

  figcaption {
    margin-top: 0.45rem;
    max-width: 40rem;
    color: var(--on-surface-variant);
    font-size: 0.875rem;
  }
</style>
