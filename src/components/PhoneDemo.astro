---
// Interactive Lucento simulation. A guide dropdown, the phone, and a coach mark.
// Written steps stay below the phone so existing hashes still open them.
// Fictional money; nothing is saved or sent.
import Mascot from './Mascot.astro';
import { guides } from '../data/guides';
import { STORIES } from '../demo/simulator';
import '../styles/phone.css';

interface Props {
  /** Section id. `/#try` redirects here. */
  id?: string;
  hashPrefix?: string;
  /** Which stories this instance offers, in order. */
  stories: string[];
  /** Story shown first. A hash such as `#guide-budget` still wins. */
  initial?: string;
}

const { id = 'try', hashPrefix = 'guide-', stories, initial } = Astro.props;

const initialKey = initial && stories.includes(initial) && STORIES[initial] ? initial : stories[0];
const guideById = new Map(guides.map((guide) => [guide.id, guide]));
const notes = stories.flatMap((key) => {
  const guide = guideById.get(key);
  return guide ? [guide] : [];
});
const first = STORIES[initialKey];
if (!first) throw new Error(`Unknown story: ${initialKey}`);
const firstStep = first.steps[0];
---

<section
  class="ld is-guided"
  id={id}
  aria-labelledby={`${id}-title`}
  data-simulator
  data-stories={stories.join(',')}
  data-prefix={hashPrefix}
  data-initial={initialKey}
>
  <div class="ld-show">
  <div class="ld-head">
    <h1 id={`${id}-title`}>Try Lucento</h1>
    <p class="ld-fine">Fictional money. Nothing is saved or sent.</p>
  </div>

  <label class="ld-pick">
    <span id={`${id}-guide-label`}>Guide</span>
    <select id={`${id}-guide`} data-tour="story" aria-labelledby={`${id}-guide-label`}>
      {
        stories.map((key) => {
          const guide = guideById.get(key);
          const story = STORIES[key];
          if (!story) return null;
          return (
            <option id={`${hashPrefix}${key}`} value={key} selected={key === initialKey}>
              {guide?.title ?? story.title}
            </option>
          );
        })
      }
    </select>
  </label>

  <p class="ld-reopen-row">
    <button type="button" class="ld-reopen" data-tour="reopen" hidden>Show the steps</button>
  </p>

  <div class="ld-stage">
    <div class="ld-bubble" data-tour="bubble" role="dialog" aria-modal="false" aria-labelledby="tour-title" tabindex="-1">
      <Mascot
        pose="pointing"
        size="2.75rem"
        alt=""
      />
      <p class="ld-count" data-tour="count">1 of {first.steps.length}</p>
      <p class="ld-bubble-title" id="tour-title" data-tour="title">{firstStep?.title}</p>
      <p class="ld-bubble-body" id="tour-body" data-tour="body">{firstStep?.body}</p>
      <div class="ld-bubble-actions">
        <button type="button" class="ld-next" data-tour="next">Next</button>
        <button type="button" class="ld-skip" data-tour="skip">Skip</button>
      </div>
    </div>

    <div class="ld-phone">
      <div class="ld-notch" aria-hidden="true"></div>
      <div class="ld-screen" data-sim="screen" role="region" aria-label="Lucento app simulation"></div>
      <div class="ld-spot" data-tour="spot" aria-hidden="true">
        <span class="ld-bar" data-bar="t"></span>
        <span class="ld-bar" data-bar="l"></span>
        <span class="ld-bar" data-bar="r"></span>
        <span class="ld-bar" data-bar="b"></span>
      </div>
    </div>
  </div>
  <p class="ld-note">Fictional data · simulation of the Android app</p>
  <p class="ld-live" data-sim="live" aria-live="polite"></p>
  </div>

  {
    notes.length > 0 && (
      <div class="ld-notes">
        <h2 id="guides" class="ld-notes-title">The same steps, written out</h2>
        {notes.map((guide) => (
          <details id={guide.id}>
            <summary>
              <span class="ld-note-title">{guide.title}</span>
              <span class="ld-note-sum">{guide.summary}</span>
            </summary>
            <ol>
              {guide.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            {guide.tip && <p class="ld-tip">{guide.tip}</p>}
          </details>
        ))}
      </div>
    )
  }
</section>

<script>
  import { mountSimulator } from '../demo/simulator';
  import { mountTour } from '../scripts/demo-tour';

  document.querySelectorAll<HTMLElement>('[data-simulator]').forEach((root) => {
    if (root.dataset.mounted) return;
    root.dataset.mounted = 'true';
    const stories = (root.dataset.stories ?? '').split(',').filter(Boolean);
    // Listen before the simulator renders, so the first step opens the coach mark.
    mountTour(root);
    mountSimulator(root, {
      stories,
      initial: root.dataset.initial || stories[0],
      hashPrefix: root.dataset.prefix ?? 'guide-',
    });
    const hash = window.location.hash.slice(1);
    const prefix = root.dataset.prefix ?? '';
    const noteId = hash.startsWith(prefix) ? hash.slice(prefix.length) : hash;
    if (!noteId) return;
    const note = root.querySelector(`details#${CSS.escape(noteId)}`);
    if (note instanceof HTMLDetailsElement) note.open = true;
  });
</script>


