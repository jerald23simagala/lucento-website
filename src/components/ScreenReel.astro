---
import { posterSlides } from '../demo/simulator';
import '../styles/phone.css';

interface Props {
  /** Crop the app to the column. No bezel, no floating phone. */
  bleed?: boolean;
}

const { bleed = false } = Astro.props;
const slides = posterSlides();
const first = slides[0];
if (!first) throw new Error('The screen reel has no slides');
---

<div class:list={['reel', bleed && 'is-bleed']} data-reel aria-roledescription="carousel" aria-label="Lucento app screens">
  <p class="reel-note">Example records. Not your money.</p>
  <div class="reel-stage" data-reel-stage>
    <div class="reel-slide">
      {
        bleed ? (
          <div class="ld-screen" inert set:html={first.html} />
        ) : (
          <div class="ld-phone" inert>
            <div class="ld-notch" aria-hidden="true" />
            <div class="ld-screen" set:html={first.html} />
          </div>
        )
      }
    </div>
  </div>
  {
    slides.map((slide) => (
      <template data-reel-template data-label={slide.label}>
        {bleed ? (
          <div class="ld-screen" inert set:html={slide.html} />
        ) : (
          <div class="ld-phone" inert>
            <div class="ld-notch" aria-hidden="true" />
            <div class="ld-screen" set:html={slide.html} />
          </div>
        )}
      </template>
    ))
  }
  <div class="reel-controls">
    <button type="button" data-reel-prev>Previous</button>
    <p>
      <span data-reel-name>{first.label}</span>
      <span class="reel-count" data-reel-count>1 of {slides.length}</span>
    </p>
    <button type="button" data-reel-next>Next</button>
  </div>
  <p class="reel-live" data-reel-live aria-live="polite"></p>
</div>

<script>
  import { mountReel } from '../scripts/screen-reel';

  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((root) => mountReel(root));
</script>

<style>
  .reel {
    min-width: 0;
  }

  .reel:focus-visible {
    outline: 3px solid var(--link);
    outline-offset: -3px;
  }

  .reel-note,
  .reel-count {
    color: var(--quiet);
  }

  .reel-note {
    width: min(360px, 100%);
    margin: 0 auto 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reel-stage {
    position: relative;
    width: min(360px, 100%);
    height: 620px;
    margin: 0 auto;
    perspective: 1400px;
  }

  .reel-slide {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .reel-slide :global(.ld-phone) {
    width: 360px;
    max-width: none;
    margin-inline: auto;
    transform: scale(0.838);
    transform-origin: top center;
    pointer-events: none;
  }

  .reel-slide.is-in-next {
    animation: reel-in-next 680ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .reel-slide.is-out-next {
    animation: reel-out-next 680ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .reel-slide.is-in-prev {
    animation: reel-in-prev 680ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .reel-slide.is-out-prev {
    animation: reel-out-prev 680ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .reel-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: center;
    width: min(360px, 100%);
    margin: 0.75rem auto 0;
  }

  .reel-controls p {
    margin: 0;
    display: grid;
    justify-items: center;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .reel-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .reel-controls button {
    min-height: 3rem;
    padding: 0 0.85rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .reel-controls button:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .reel-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .reel.is-bleed {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    background: var(--paper);
  }

  .reel.is-bleed .reel-note {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reel.is-bleed .reel-stage {
    flex: 1;
    width: 100%;
    height: auto;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    perspective: 1200px;
    container-type: size;
  }

  .reel.is-bleed .reel-slide :global(.ld-screen) {
    width: 390px;
    height: 844px;
    border-radius: 0;
    transform: scale(2.2);
    transform: scale(calc(100cqw / 390px));
    transform-origin: top left;
    pointer-events: none;
  }

  .reel.is-bleed .reel-controls {
    width: 100%;
    margin: 0;
    padding: 0.35rem 0.7rem;
    background: var(--ink);
    color: var(--paper);
  }

  .reel.is-bleed .reel-controls p,
  .reel.is-bleed .reel-count {
    color: var(--paper);
  }

  .reel.is-bleed .reel-controls button {
    border-color: transparent;
    background: transparent;
    color: var(--spot);
    padding: 0 0.4rem;
  }

  .reel.is-bleed .reel-controls button:hover {
    background: transparent;
    color: var(--paper);
  }

  @keyframes reel-in-next {
    from {
      transform: rotateY(72deg);
      opacity: 0.25;
    }
    to {
      transform: rotateY(0deg);
      opacity: 1;
    }
  }

  @keyframes reel-out-next {
    from {
      transform: rotateY(0deg);
      opacity: 1;
    }
    to {
      transform: rotateY(-72deg);
      opacity: 0;
    }
  }

  @keyframes reel-in-prev {
    from {
      transform: rotateY(-72deg);
      opacity: 0.25;
    }
    to {
      transform: rotateY(0deg);
      opacity: 1;
    }
  }

  @keyframes reel-out-prev {
    from {
      transform: rotateY(0deg);
      opacity: 1;
    }
    to {
      transform: rotateY(72deg);
      opacity: 0;
    }
  }
</style>
