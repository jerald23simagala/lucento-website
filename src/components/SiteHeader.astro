---
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="inner">
    <a class="home" href="/" aria-label="Lucento home">
      <Logo />
    </a>
    <nav class="links" aria-label="Site">
      <a href="/#write">How it works</a>
      <a href="/#light">The light</a>
      <a href="/#app">The app</a>
      <a href="/#privacy">Privacy</a>
      <a href="/how-to">Guides</a>
    </nav>
    <div class="end">
      <p class="status">Android · in development</p>
      <a class="cta" href="/#try">Try the demo</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--outline-variant);
    background: var(--background);
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 14px var(--page-gutter);
    display: flex;
    align-items: center;
    gap: 20px 32px;
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch);
    text-decoration: none;
  }

  .links {
    display: flex;
    flex-wrap: nowrap;
    gap: 4px 28px;
    flex: 1;
    min-width: 0;
  }

  .links a,
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--on-surface);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
  }

  .links a:hover {
    color: var(--primary);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  .status {
    margin: 0;
    color: var(--on-surface-variant);
    font-size: 13px;
    font-weight: 600;
  }

  .cta {
    padding: 0 18px;
    border-radius: 14px;
    background: var(--primary);
    color: var(--on-primary);
  }

  .cta:hover {
    background: #2447c7;
    color: #fff;
  }

  @media (max-width: 860px) {
    .links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .status {
      display: none;
    }
  }
</style>
