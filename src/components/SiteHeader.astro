---
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="bar">
    <a class="home" href="/" aria-label="Lucento home">
      <Logo />
    </a>
    <nav aria-label="Site">
      <input id="site-menu" class="nav-toggle" type="checkbox" />
      <label class="menu-button" for="site-menu">
        <span class="when-closed">Menu</span>
        <span class="when-open">Close</span>
      </label>
      <ul class="nav-links">
        <li><a href="/#pace">The month</a></li>
        <li><a href="/demo">Guides</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a class="btn" href="/demo">Try the demo</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--background);
    border-bottom: 1px solid var(--outline-variant);
  }

  .bar {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0.85rem var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .home {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: var(--min-touch);
    text-decoration: none;
  }

  .nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .menu-button {
    display: none;
  }

  .when-open {
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: var(--min-touch);
    padding: 0 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--on-surface);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:not(.btn):hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  nav .btn {
    flex: none;
    margin-left: 0.35rem;
    white-space: nowrap;
  }

  .nav-toggle:focus-visible + .menu-button {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  @media (min-width: 1080px) {
    .nav-toggle {
      display: none;
    }
  }

  @media (max-width: 1079px) {
    .bar {
      flex-wrap: wrap;
    }

    nav {
      display: contents;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      min-height: var(--min-touch);
      padding: 0 0.85rem;
      border: 1px solid var(--border-default);
      border-radius: var(--radius-sm);
      background: var(--surface-container-lowest);
      color: var(--on-surface);
      font-weight: 700;
      cursor: pointer;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.25rem 0 0.4rem;
    }

    .nav-toggle:checked ~ .nav-links {
      display: flex;
    }

    .nav-toggle:checked ~ .menu-button .when-closed {
      display: none;
    }

    .nav-toggle:checked ~ .menu-button .when-open {
      display: inline;
    }

    .nav-toggle:checked ~ .nav-links .btn {
      width: 100%;
      margin: 0.35rem 0 0;
    }
  }
</style>
