---
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="bar">
    <a class="home" href="/" aria-label="Lucento home">
      <Logo />
    </a>
    <nav aria-label="Site">
      <input id="site-menu" class="nav-toggle" type="checkbox" />
      <label class="menu-button" for="site-menu">
        <span class="when-closed">Menu</span>
        <span class="when-open">Close</span>
      </label>
      <ul class="nav-links">
        <li><a href="/#record">The record</a></li>
        <li><a href="/#pace">The month</a></li>
        <li><a href="/demo">Guides</a></li>
        <li><a href="/#faq">Questions</a></li>
        <li><a href="/demo">Try the demo</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-h);
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
  }

  .bar {
    max-width: none;
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .home {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 3rem;
    color: var(--ink);
    text-decoration: none;
  }

  .nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .menu-button {
    display: none;
  }

  .when-open {
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 3rem;
    padding: 0 0.7rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--spot);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.28em;
  }

  .nav-links li:last-child a {
    text-decoration: underline;
    text-decoration-color: var(--spot);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.28em;
  }

  .nav-toggle:focus-visible + .menu-button {
    outline: 3px solid var(--link);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .site-header {
      height: auto;
    }

    .bar {
      flex-wrap: wrap;
      min-height: var(--header-h);
      padding-top: 0.35rem;
      padding-bottom: 0.35rem;
    }

    nav {
      display: contents;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      margin-left: auto;
      min-height: 3rem;
      padding: 0 0.85rem;
      border: 1px solid var(--ink);
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.15rem 0 0.5rem;
      border-top: 1px solid var(--ink);
    }

    .nav-toggle:checked ~ .nav-links {
      display: flex;
    }

    .nav-toggle:checked ~ .menu-button .when-closed {
      display: none;
    }

    .nav-toggle:checked ~ .menu-button .when-open {
      display: inline;
    }
  }
</style>
