---
import Logo from './Logo.astro';
---

<header class="site-header">
  <div class="bar">
    <a class="home" href="/" aria-label="Lucento home">
      <Logo />
    </a>
    <nav aria-label="Site">
      <details class="menu">
        <summary>
          <span class="when-closed">Menu</span>
          <span class="when-open">Close</span>
        </summary>
        <ul>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/#pace">The month</a></li>
          <li><a href="/how-to">Guides</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a class="btn" href="/#try">Try the demo</a></li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--background);
    border-bottom: 1px solid var(--outline-variant);
  }

  .bar {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0.65rem var(--page-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch);
    text-decoration: none;
  }

  .menu > ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  summary {
    display: none;
  }

  .when-open {
    display: none;
  }

  nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: var(--min-touch);
    padding: 0 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--on-surface);
    font-weight: 650;
    text-decoration: none;
  }

  nav a:not(.btn):hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  @media (min-width: 880px) {
    .menu:not([open]) > ul {
      display: flex !important;
    }
  }

  @media (max-width: 879px) {
    .bar {
      flex-wrap: wrap;
    }

    nav {
      margin-left: auto;
    }

    summary {
      display: inline-flex;
      align-items: center;
      min-height: var(--min-touch);
      padding: 0 0.85rem;
      border: 1px solid var(--border-default);
      border-radius: var(--radius-sm);
      background: var(--surface-container-lowest);
      color: var(--on-surface);
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    .menu[open] .when-closed {
      display: none;
    }

    .menu[open] .when-open {
      display: inline;
    }

    .menu[open] {
      width: 100%;
    }

    .menu:not([open]) > ul {
      display: none;
    }

    .menu[open] > ul {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.35rem 0 0.5rem;
    }

    .menu[open] .btn {
      width: 100%;
      margin-top: 0.25rem;
    }
  }
</style>
