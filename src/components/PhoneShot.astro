---
interface Props {
  id: string;
  alt: string;
  sizes: string;
  /** Source screenshot filename, for the build record. Not shown. */
  source: string;
  fallback: string;
  eager?: boolean;
}

const { id, alt, sizes, source, fallback, eager = false } = Astro.props;
const widths = [540, 720, 1080] as const;
const srcset = (ext: string) => widths.map((w) => `/screens/${id}-${w}.${ext} ${w}w`).join(', ');
---

<div class="device" data-shot={source}>
  <div class="device-scr">
    <span class="device-cam" aria-hidden="true"></span>
    <picture>
      <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
      <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
      <img
        src={`/screens/${id}-720.webp`}
        srcset={srcset('webp')}
        sizes={sizes}
        alt={alt}
        width="1080"
        height="1920"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
      />
    </picture>
    <p class="device-fallback">{fallback}</p>
  </div>
</div>
