---
import '../styles/phone.css';

interface Props {
  class?: string;
  /** Source screenshot filename, for the build record. Not shown. */
  shot?: string;
}

const { class: className, shot } = Astro.props;
---

<div class:list={['phone', className]} data-shot={shot}>
  <div class="phone-screen">
    <span class="phone-cam" aria-hidden="true"></span>
    <slot />
  </div>
</div>
