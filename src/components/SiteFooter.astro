---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Product',
    links: [
      { href: '/#write', label: 'How it works' },
      { href: '/#light', label: 'The light' },
      { href: '/#app', label: 'The app' },
      { href: '/#try', label: 'Interactive demo' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/how-to', label: 'Guides' },
      { href: '/#answers', label: 'Questions' },
      { href: '/#answers', label: 'Current limitations' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/#privacy', label: 'Privacy at a glance' },
      { href: '/privacy', label: 'How we handle your data' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="brand">
      <a href="/" aria-label="Lucento home"><Logo tone="light" /></a>
      <p>Financial clarity without the complexity. A budget tracker for Android, in development.</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="col-title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <p class="base">© {year} Lucento. Screens show the app’s demo data; figures on this page are fictional.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #10182b;
    color: #b8c5dc;
    font-size: 15px;
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 56px var(--page-gutter) 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
  }

  .brand {
    flex: 1 1 280px;
  }

  .brand p {
    max-width: 32ch;
    margin: 14px 0 0;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 9rem;
  }

  .col-title {
    margin: 0;
    color: #8a97b0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #b8c5dc;
    text-decoration: none;
  }

  a:hover {
    color: #fff;
  }

  .base {
    flex: 1 1 100%;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid #26365c;
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .inner {
      gap: 28px 32px;
    }
  }
</style>
