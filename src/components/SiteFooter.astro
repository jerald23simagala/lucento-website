---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Product',
    links: [
      { href: '/demo', label: 'Interactive demo' },
      { href: '/#keeps', label: 'On your phone' },
      { href: '/#pace', label: 'The month’s pace' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/demo', label: 'Interactive guides' },
      { href: '/demo#guides', label: 'Written steps' },
      { href: '/#faq', label: 'FAQ' },
      { href: '/#good-to-know', label: 'Current limitations' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/#privacy', label: 'Privacy at a glance' },
      { href: '/privacy', label: 'How we handle your data' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="crest-rule" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="inner">
    <div class="brand">
      <a href="/" aria-label="Lucento home"><Logo size="footer" /></a>
      <p>Financial clarity without the complexity. A budget tracker for Android, in development.</p>
    </div>
    {
      columns.map((c) => (
        <nav aria-label={c.title}>
          <p class="col-title">{c.title}</p>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="base">
    <p>© {year} Lucento. The interactive demo uses fictional data and simulates the Android app.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xxl);
    background: var(--surface-container-low);
    color: var(--on-surface-variant);
    font-size: 0.9375rem;
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-xxl) var(--page-gutter) var(--space-xl);
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(8rem, 1fr));
    gap: var(--space-xl) var(--space-lg);
  }

  .brand p {
    max-width: 22rem;
    margin: var(--space-md) 0 0;
  }

  .brand a {
    display: inline-flex;
    min-height: var(--min-touch);
    align-items: center;
  }

  .col-title {
    margin: 0;
    color: var(--on-surface);
    font-weight: 700;
  }

  ul {
    margin: var(--space-xs) 0 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--on-surface-variant);
    text-decoration: none;
  }

  li a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .base {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-lg) var(--page-gutter) var(--space-xl);
    border-top: 1px solid var(--outline-variant);
    font-size: 0.8125rem;
  }

  .base p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 460px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
