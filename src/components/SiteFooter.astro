---
import Logo from './Logo.astro';
import Crest from './Crest.astro';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Product',
    links: [
      { href: '/demo', label: 'Interactive demo' },
      { href: '/#keeps', label: 'On your phone' },
      { href: '/#pace', label: 'The month’s pace' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/demo', label: 'Interactive guides' },
      { href: '/demo#guides', label: 'Written steps' },
      { href: '/#faq', label: 'FAQ' },
      { href: '/#good-to-know', label: 'Current limitations' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/#privacy', label: 'Privacy at a glance' },
      { href: '/privacy', label: 'How we handle your data' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="inner">
    <div class="brand">
      <a href="/" aria-label="Lucento home"><Logo size="footer" /></a>
      <p>Financial clarity without the complexity. A budget tracker for Android, in development.</p>
      <Crest size="sm" />
    </div>
    {
      columns.map((c) => (
        <nav aria-label={c.title}>
          <p class="col-title">{c.title}</p>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="base">
    <p>© {year} Lucento. The interactive demo uses fictional data and simulates the Android app.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 0;
    background: var(--night);
    color: #d5deef;
    font-size: 0.9375rem;
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2.4rem var(--page-gutter) 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(8rem, 1fr));
    gap: 1.5rem 1.75rem;
  }

  .brand p {
    max-width: 22rem;
    margin: 0.8rem 0 0.9rem;
  }

  .brand a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    color: #f4f7ff;
  }

  .col-title {
    margin: 0;
    color: #f4f7ff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ul {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: #d5deef;
    text-decoration: none;
  }

  li a:hover {
    color: var(--spot);
    text-decoration: underline;
  }

  .base {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0.9rem var(--page-gutter) 1.4rem;
    border-top: 1px solid rgba(244, 247, 255, 0.18);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .base p {
    margin: 0;
  }

  @media (max-width: 800px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 460px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
