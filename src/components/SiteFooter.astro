---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p>© {year} Lucento</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
    font-size: 0.875rem;
  }

  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-xl) var(--page-gutter);
  }

  p {
    margin: 0;
  }
</style>
