---
/**
 * A real app screen in the phone frame: the Sunrise (light) capture for Day, Midnight for Night, same demo figures.
 * Screens come from the API 36 screenshot tour in peso mode, cropped by lucento-studio qa/crop-screen.mjs into 400, 560
 * and 720 px widths, AVIF first (about a third smaller) with WebP as the fallback. Whenever the screen shows money,
 * the caption says the figures are examples.
 */
interface Props {
  screen: 'home' | 'composer';
  alt: string;
  caption?: string;
  /** The hero's phone: fetched early instead of lazily. */
  priority?: boolean;
}

const { screen, alt, caption = 'The app’s demo data: example figures.', priority = false } = Astro.props;
const set = (theme: 'light' | 'dark', format: 'avif' | 'webp') =>
  [400, 560, 720].map((w) => `/screens/${screen}-${theme}-${w}.${format} ${w}w`).join(', ');
const sizes = 'min(300px, 78vw)';
const dark = '(prefers-color-scheme: dark)';
---

<figure class="stand">
  <figcaption class="caption">{caption}</figcaption>
  <div class="phone">
    <picture>
      <source media={dark} type="image/avif" srcset={set('dark', 'avif')} sizes={sizes} width="720" height="1471" />
      <source media={dark} type="image/webp" srcset={set('dark', 'webp')} sizes={sizes} width="720" height="1471" />
      <source type="image/avif" srcset={set('light', 'avif')} sizes={sizes} width="720" height="1471" />
      <img
        src={`/screens/${screen}-light-720.webp`}
        srcset={set('light', 'webp')}
        sizes={sizes}
        width="720"
        height="1471"
        alt={alt}
        decoding="async"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </picture>
  </div>
</figure>
