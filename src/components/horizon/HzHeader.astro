---
import HzLogo from './HzLogo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/pricing', label: 'Pricing' },
  { href: '/how-to', label: 'Guides' },
  { href: '/privacy', label: 'Privacy' },
];
---

<div class="wrap">
  <header class="site-header">
    <a class="brand" href="/" aria-label="Lucento home"><HzLogo /></a>
    <nav class="site-nav" aria-label="Site">
      {links.map((link) => <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </header>
</div>
