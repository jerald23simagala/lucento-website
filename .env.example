# Public origin of the deployed site, e.g. https://lucento.app (no trailing slash).
# When unset, canonical URLs and the sitemap are omitted instead of pointing at a made-up domain.
SITE_URL=

# --- Server-side secrets for api/interpret (Smarter reading) and api/ask (Ask Lucento) in the Lucento app ---------
# Set these in Vercel → lucento-website → Settings → Environment Variables (Production, and Preview if you test there).
# Never commit real values; .env files are git-ignored.

# From Google AI Studio (https://aistudio.google.com/apikey). Secret: only the function reads it.
GEMINI_API_KEY=

# The Supabase project the app syncs with, and its publishable key (the one already in the APK). Never a service key.
# The LUCENTO_SUPABASE_URL / LUCENTO_SUPABASE_PUBLISHABLE_KEY names (as on Vercel) work too; so does LUCENTO_SITE_URL for SITE_URL.
SUPABASE_URL=https://hmtcuttadbgbldvzsfhz.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional: requests per user per UTC day (default 50), and a Gemini model to pin. Leave GEMINI_MODEL empty to use
# the newest stable Flash model the key can use (src/server/gemini.ts) — Google retires models (gemini-2.5-flash, 2026).
AI_DAILY_LIMIT=50
GEMINI_MODEL=

# --- Lucento Pro: Google Play purchases (api/billing/verify, api/billing/rtdn, api/billing/voided) -------------------
# Secrets: Vercel env only, Production scope. Never in the APK, never committed (lucento-android CLAUDE.md).
# See lucento-android docs/monetization/PLAY_CONSOLE_SETUP.md for where each one comes from.

# Supabase → Project settings → API keys → secret (or legacy service_role) key of the SAME project as SUPABASE_URL.
# The only key allowed to call public.apply_play_purchase / public.revoke_play_purchase.
LUCENTO_SUPABASE_SERVICE_ROLE_KEY=

# The Play Console service account's JSON key, pasted whole (one line). Needs "View financial data" and
# "Manage orders and subscriptions" for the Lucento app.
LUCENTO_PLAY_SERVICE_ACCOUNT_JSON=

# Optional; the release application id.
LUCENTO_PLAY_PACKAGE_NAME=com.lucento.app

# Any long random string. The Pub/Sub push subscription posts to /api/billing/rtdn?token=<this value>.
LUCENTO_RTDN_PUSH_TOKEN=

# Optional, security audit F-10: Pub/Sub push authentication (OIDC). Set both once the push subscription has
# authentication on (docs/security/OWNER_ACTIONS_REQUIRED.md in lucento-android). The audience is the value typed in the
# subscription (e.g. https://www.lucentoapp.com/api/billing/rtdn); the service account is the one it signs as. Not secret.
LUCENTO_RTDN_OIDC_AUDIENCE=
LUCENTO_RTDN_OIDC_SERVICE_ACCOUNT=

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/billing/voided once a day (vercel.json).
CRON_SECRET=

# --- Account emails (api/account/welcome, and the Pro confirmation in api/billing/verify) ----------------------------
# lucento-android docs/EMAILS.md. Needs LUCENTO_SUPABASE_SERVICE_ROLE_KEY above (public.claim_account_email).
# Resend → API Keys → a key with "Sending access" limited to send.lucentoapp.com. Secret: Vercel env only.
LUCENTO_RESEND_API_KEY=
# Optional overrides.
LUCENTO_EMAIL_FROM=Lucento <hello@send.lucentoapp.com>
LUCENTO_EMAIL_REPLY_TO=lucentoapp@gmail.com
